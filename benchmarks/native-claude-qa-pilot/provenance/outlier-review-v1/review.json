  "findings": [
    {
      "type": "confirmed_estimand_design_risk",
      "source_lines": [
        325,
        355
      ],
      "finding": "Independent post-treatment score-tail selection can change a resource comparison even when every original baseline/zg resource pair is identical. This is a score-conditioned estimator rather than the unfiltered resource effect; paired resampling does not make the estimands identical.",
      "recommendation": "Keep complete ten-observation arithmetic means primary. Retain score-tail results as a separately named compatibility sensitivity. Add robust paired-contrast estimates independent of quality ranking."
    },
    {
      "type": "confirmed_design_limitation",
      "source_lines": [
        325,
        340
      ],
      "finding": "With ten identical scores, deterministic tie handling still removes repetitions1 and10 and retains an unrelated resource extreme at repetition9. Fixed score-tail trimming is not identification of unusual resource measurements.",
      "recommendation": "Show tie counts and exact exclusions. Do not label every excluded row an invalid execution or a measured resource outlier."
    },
    {
      "type": "statistical_calibration_not_established",
      "source_lines": [
        37,
        65
      ],
      "finding": "The five-task guard is explicitly an engineering choice; NIST modified-Z guidance labels potential outliers and does not calibrate the maximum of profile-wise estimated dispersions across three metrics on five heterogeneous tasks.",
      "recommendation": "Keep all five questions in the primary macro. Show task MAD only as a diagnostic, with zero-MAD guard, excluded identities and leave-one-task influence."
    }
  ],
  "correct_existing_behavior": [
    "Whole-pair bootstrap draws are shared between profiles before score trimming.",
    "Trimming is recomputed inside each bootstrap draw.",
    "Historical raw records, failed validity gates and unknown judgments are preserved.",
    "Zero MAD and insufficient task counts disable the applicable screen."
