  },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/claude-qa-pilot/results/20261019/issue-expansion-v1/q003/pair-verdict.json\",\n+          \"sha256\": \"f6d7064973693073c1e17cdfd812ba81e1fd467250a50eebb914ec213e4b9f5b\"\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/claude-qa-pilot/results/20261019/issue-expansion-v1/q003/source-manifest.json\",\n+          \"sha256\": \"1a46ac5f55bf90dad6a3333e3c67aff1bde54f819990456e0a60be6f83109e1c\"\n+        }\n+      ],\n+      \"prior_results_policy\": \"Preserve these earlier custom-Claude results unchanged. They are neither native-Claude replications nor eligible for pooling with a future native phase.\"\n+    }\n+  ],\n+  \"reuse_findings\": [\n+    {\n+      \"component\": \"native evidence adapters and accounting\",\n+      \"classification\": \"task-neutral; no change needed\",\n+      \"finding\": \"QABaseline/QAZvec consume qa_source_manifest[files] and /workspace. compare_inventory checks all expected files plus the same treatment index allowlist; no q001 commit/count gate. accounting_v2 task_id means native child Agent ID, not benchmark task identity. Native parents, prompts, environment, tool policy, CLI flags, model, budgets, provider routing, setup/index and accounting should remain byte-for-byte unchanged.\",\n+      \"sources\": [\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/native_claude/agents.py\",\n+          \"sha256\": \"4f53f92d6c659b6444d3ba88afda4753cf49200e9e6aa73a803f3c194bc46eed\",\n+          \"line\": 170\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/opencode-qa-pilot/qa_agents.py\",\n+          \"sha256\": \"140b6512a3a9308c90e4b6006c2d73d5cf03920f500a586e8ff2db461b39d17c\",\n+          \"line\": 55\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/accounting_v2.py\",\n+          \"sha256\": \"6505f113c7994f67818e353aee68352762db177655b33e44c67b8cd87de5735d\",\n+          \"line\": 172\n+        }\n+      ]\n+    },\n+    {\n+      \"component\": \"pilot preparation/validation\",\n+      \"classification\": \"hard task identity bindings requiring a separate versioned task preparation/validator\",\n+      \"finding\": \"FIXED binds q001 dataset/question/rubric/source commit/count 1232. prepare invokes exporter --task q001 and dataset.json, copies q001 instruction, writes tasks/zvec-q001, metadata task_id and suite zvec-q001. Passing q002/q003 as a renamed plan is rejected or would still prepare q001. Existing prepare_corpus already supports explicit --task with dataset-expansion-v1.json and verifies exact frozen assets, source and rubric spans; only host task assembly/identity must be separately parameterized. Keep Dockerfile, verifier and 1800/60/1200 budgets the same.\",\n+      \"sources\": [\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/opencode-qa-pilot/pilot.py\",\n+          \"sha256\": \"3a27904041c3a93f7ee5d35740c6d85cbf1ad862fe19f02609821f0ad87991b8\",\n+          \"line\": 21\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/opencode-qa-pilot/pilot.py\",\n+          \"sha256\": \"3a27904041c3a93f7ee5d35740c6d85cbf1ad862fe19f02609821f0ad87991b8\",\n+          \"line\": 68\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/opencode-qa-pilot/pilot.py\",\n+          \"sha256\": \"3a27904041c3a93f7ee5d35740c6d85cbf1ad862fe19f02609821f0ad87991b8\",\n+          \"line\": 116\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/prepare_corpus.py\",\n+          \"sha256\": \"eed5b21c622d6f2c3805ba925fcd9bc3611c33c0292b58b400aec1ef4816e51e\",\n+          \"line\": 36\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/prepare_corpus.py\",\n+          \"sha256\": \"eed5b21c622d6f2c3805ba925fcd9bc3611c33c0292b58b400aec1ef4816e51e\",\n+          \"line\": 59\n+        }\n+      ]\n+    },\n+    {\n+      \"component\": \"legacy q001 job names, container discovery and collector paths\",\n+      \"classification\": \"internal naming; can remain unchanged if explicitly documented\",\n+      \"finding\": \"integration.build_command uses q001-{profile} solely as --job-name. Main runner derives --include-task-name from suite.tasks. pilot.capture_slot_containers and live.collect consistently locate this legacy prefix. A new isolated phase may retain these original function bodies and prefix while actual task is zvec-q002 or zvec-q003; job directory names must never serve as the actual-task assertion. Changing only this display prefix is unnecessary and would require changing every coupled lookup.\",\n+      \"sources\": [\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/native_claude/integration.py\",\n+          \"sha256\": \"669ac033aac53d1bc5bb49d52b93cbb336fcd734acd39db95919c05bed9c59a5\",\n+          \"line\": 102\n+        },\n+        {\n+          \"path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/upstream-main/benchmarks/swe-qa-bench/zg_bench/runner.py\",\n+          \"sha256\": \"543bbaea8621d5440010d8874a361d2a1381b1e5d300bec642c27824794d7951\",\n+          \"line\": 708\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/opencode-qa-pilot/pilot.py\",\n+          \"sha256\": \"3a27904041c3a93f7ee5d35740c6d85cbf1ad862fe19f02609821f0ad87991b8\",\n+          \"line\": 212\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 421\n+        }\n+      ]\n+    },\n+    {\n+      \"component\": \"live validation and collection task identity\",\n+      \"classification\": \"hard validation plus missing cross-task assertions\",\n+      \"finding\": \"live.validate_plan inherits pilot.FIXED, validates the original q001 experiment/prepared archive, and hashes fixed q001 question/rubric paths. The original collector validates execution protocol/plan/package/root/runtime/source-audit status but does not itself compare native lock.task.name/digest, result.task_checksum or the audited manifest against an independently selected q002/q003 entry. A later versioned wrapper must bind explicit task ID, dataset SHA, exact question/rubric/source manifest, prepared bytes, suite single-task selection and both native task hash algorithms; preserve collection bodies and retain a task-identity sidecar/review instead of relabeling results afterwards.\",\n+      \"sources\": [\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 34\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 88\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 110\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 396\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 455\n+        }\n+      ]\n+    },\n+    {\n+      \"component\": \"accepted q001 fake-provider proof\",\n+      \"classification\": \"reusable engine evidence with finite scope\",\n+      \"finding\": \"Existing R3 synchronous and background probe evidence can continue to bind native binary/setup, adapters and accounting semantics. It does not demonstrate q002/q003 task assembly, indexed coverage, source-only tool usage or end-to-end results. No new provider/Docker run is implied by this readiness review.\",\n+      \"sources\": [\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/native_claude/integration.py\",\n+          \"sha256\": \"669ac033aac53d1bc5bb49d52b93cbb336fcd734acd39db95919c05bed9c59a5\",\n+          \"line\": 121\n+        },\n+        {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/live.py\",\n+          \"sha256\": \"6f625a7ee0c090063f295c780f2eefb275f5fa1a29d8137fcf4f076a6ee1906b\",\n+          \"line\": 51\n+        }\n+      ]\n+    }\n+  ],\n+  \"minimal_future_boundary\": [\n+    \"Use a separately frozen phase/decision/workflow and explicit task ID for each of q002 and q003; do not alter the current confirmation or any frozen base/native/accounting files.\",\n+    \"Reuse existing prepare_corpus with dataset-expansion-v1.json and the selected task. Assemble the same Harbor task support bytes except the exact original question, task ID/source snapshot, and suite task name; pin the new prepared inventory.\",\n+    \"Validate unchanged parent/runtime/provider/package/budgets separately, then verify the selected expansion task. Retain original run_slot/run_pair/collect bodies with a new protocol and explicit task identity sidecar; legacy q001 job prefix may stay internal.\",\n+    \"Before accepting any result, match sidecar/plan to suite --include-task-name, actual native lock task name/flat digest, result task checksum, unchanged question bytes and before/after full source inventory. Task ID must not be inferred from job prefix.\",\n+    \"Preserve independent grading against each original rubric and task-specific source-use rules, all scheduled outcomes, setup/index costs, strict/reporting scopes, cleanup bounds and no replacement. Native index coverage on the new snapshots remains to be observed if a phase is later authorized.\"\n+  ],\n+  \"existing_tests\": {\n+    \"count\": 35,\n+    \"inspection\": \"Static inventory only; no tests or execution rerun in this review. Existing passing status is not a new cross-task proof.\",\n+    \"files\": [\n+      {\n+        \"file\": {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_live.py\",\n+          \"sha256\": \"4acd8a867cc3f56470dfdc26ba1ae53f494cf002cd497b0df8dbe11761bd2cf9\"\n+        },\n+        \"count\": 15,\n+        \"test_names\": [\n+          \"test_environment_allowlist_parent_route_and_baseline_isolation\",\n+          \"test_environment_restores_on_error_and_missing_embedding_prevents_first_slot\",\n+          \"test_endpoint_rejects_credentials_queries_and_non_https\",\n+          \"test_reported_usage_exact_scope_cache_and_no_missing_zero_fallback\",\n+          \"test_complete_evidence_contradiction_withholds_but_extra_reported_usage_does_not\",\n+          \"test_cleanup_uncertainty_retains_second_slot_not_started\",\n+          \"test_cleaned_failed_slot_does_not_replace_or_skip_scheduled_second\",\n+          \"test_deadline_in_cache_preparation_still_retains_cleanup\",\n+          \"test_offline_proof_requires_success_hashes_review_and_all_retained_bytes\",\n+          \"test_failed_proof_and_unaccepted_review_fail_closed\",\n+          \"test_usage_only_missing_does_not_invalidate_answer_or_substitute_strict_totals\",\n+          \"test_identity_error_keeps_answer_but_invalidates_execution\",\n+          \"test_missing_scheduled_slot_kept_without_synthetic_zeros\",\n+          \"test_retained_linux_mounts_do_not_resolve_on_analyst_filesystem\",\n+          \"test_timing_intervals_retain_timestamps_and_missing_is_not_zero\"\n+        ],\n+        \"mentions_q002_or_q003\": false\n+      },\n+      {\n+        \"file\": {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_accounting_v2.py\",\n+          \"sha256\": \"5436cd556eb33571205501b9f7f91fd9b8331ba98dfcc4a3cac1fa776620e05e\"\n+        },\n+        \"count\": 12,\n+        \"test_names\": [\n+          \"test_actual_async_probe_resolves_only_two_errors_with_identical_totals\",\n+          \"test_both_actual_r3_sync_profiles_are_exact_original_dicts\",\n+          \"test_each_observed_completion_channel_alone\",\n+          \"test_running_child_without_terminal_evidence_remains_unfinished\",\n+          \"test_orphan_child_and_orphan_notification_remain_invalid\",\n+          \"test_conflicting_notification_is_not_overridden_by_valid_taskoutput\",\n+          \"test_conflicting_taskoutput_is_not_overridden_by_valid_notification\",\n+          \"test_user_text_is_not_native_completion_and_post_terminal_notification_rejected\",\n+          \"test_resolved_model_and_existing_usage_errors_are_not_relaxed\",\n+          \"test_notification_must_follow_bound_launch_start_and_child_final\",\n+          \"test_taskoutput_must_finish_before_parent_final\",\n+          \"test_taskoutput_argument_cannot_disagree_with_its_completed_result\"\n+        ],\n+        \"mentions_q002_or_q003\": false\n+      },\n+      {\n+        \"file\": {\n+          \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_confirmation_v1.py\",\n+          \"sha256\": \"4c1c1e6a1df40633874bf3a4f89615e47d52a4e9cbf006bb00d5e7d3919c3259\"\n+        },\n+        \"count\": 8,\n+        \"test_names\": [\n+          \"test_original_plan_validation_precedes_new_protocol_and_pair_selection\",\n+          \"test_references_controls_and_config_overrides_fail_closed\",\n+          \"test_decision_exact_schedule_and_development_candidate_required\",\n+          \"test_private_instances_preserve_every_original_function_body\",\n+          \"test_dry_run_is_provider_free_records_new_identity_and_refuses_replacement\",\n+          \"test_cleanup_uncertainty_stops_reverse_pair_and_run_returns_nonzero\",\n+          \"test_actual_collector_body_supports_reverse_order_and_exact_provenance\",\n+          \"test_context_retained_if_original_run_fails_before_first_slot\"\n+        ],\n+        \"mentions_q002_or_q003\": false\n+      }\n+    ],\n+    \"covered\": [\n+      \"Environment allowlist/provider routing, cache-inclusive reported usage and strict corroboration, missing usage and contradictions, timeout and cleanup/no-replacement boundaries, missing trials, timing scopes.\",\n+      \"Actual R3 sync and native async persisted logs, child/task identity, terminal ordering, conflict/orphan/unfinished fail-closed behavior.\",\n+      \"Original function body reuse, confirmation plan/control binding, reverse profile order, dry-run isolation, sidecar identity and failed/partial collection.\"\n+    ],\n+    \"not_covered\": [\n+      \"No q002/q003 identity appears in these 35 tests; synthetic live collection and actual R3 fixtures use q001 jobs.\",\n+      \"No assertion binds an expansion dataset entry to generated Harbor task/source/question, selected --include-task-name and native lock/result hashes.\",\n+      \"No negative cross-task substitution test (q002 question with q003 source/rubric, or wrong task inside legacy q001 job directory).\",\n+      \"No q002/q003 native index-coverage or actual e2e result proof.\"\n+    ],\n+    \"additional_existing_exporter_tests\": {\n+      \"file\": {\n+        \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/test_prepare_corpus.py\",\n+        \"sha256\": \"1b3520bf1e2759026088722ca6abd7bbd9e1532a743d8c0b2c6643c105d3dbdb\"\n+      },\n+      \"count\": 19,\n+      \"coverage\": \"Separate 19 synthetic exporter tests already cover explicit task selection, hashes/source identity, full inventory, evidence spans, leakage, archive links/path isolation and manifest placement; they are not among the 35 native-controller tests and do not exercise Harbor assembly.\"\n+    }\n+  },\n+  \"readiness_verdict\": {\n+    \"assets_available_and_verified\": true,\n+    \"native_agent_behavior_change_needed\": false,\n+    \"new_harness_framework_needed\": false,\n+    \"current_frozen_controller_can_directly_execute_expansion\": false,\n+    \"minimal_task_identity_wrapper_and_preparation_needed\": true,\n+    \"paid_execution_authorized\": false,\n+    \"future_result_or_benefit_claimed\": false\n+  },\n+  \"actions_taken\": [\n+    \"Read frozen assets/code and existing test source.\",\n+    \"Read local Git commit objects and streamed git archives in memory; compared every archived file byte hash with existing exported source and manifests.\",\n+    \"Rehashed 17 + 29 existing rubric evidence spans; scanned all exported files for frozen forbidden markers.\",\n+    \"Wrote this report only; no Git/code/raw-result changes, checkout/export regeneration, provider/Docker/CI calls, new trials or grading.\"\n+  ]\n+}"},{"sha":"029ca3fe9763bcf450026ebbe482aa1719ed8d38","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/native-expansion-rebuild-verification-v1.json","status":"added","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-rebuild-verification-v1.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-rebuild-verification-v1.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-rebuild-verification-v1.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,98 @@\n+{\n+  \"checked_at_utc\": \"2026-10-20T00:18:10.160135+00:00\",\n+  \"checks\": [\n+    {\n+      \"name\": \"group.json:same_sha256\",\n+      \"passed\": true\n+    },\n+    {\n+      \"name\": \"q002/prepared.json:same_sha256\",\n+      \"passed\": true\n+    },\n+    {\n+      \"name\": \"q003/prepared.json:same_sha256\",\n+      \"passed\": true\n+    },\n+    {\n+      \"name\": \"q002:same_native_task_hashes\",\n+      \"passed\": true\n+    },\n+    {\n+      \"name\": \"q003:same_native_task_hashes\",\n+      \"passed\": true\n+    },\n+    {\n+      \"name\": \"reference_prepared_metadata_unchanged\",\n+      \"passed\": true\n+    }\n+  ],\n+  \"existing_output_verified\": null,\n+  \"files\": [\n+    {\n+      \"original_path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/native-expansion-prepared-v1/group.json\",\n+      \"original_sha256\": \"4e02167d7352670d2c78d6332427e7b9d709a96d38249ed91d3b493af3ef9c23\",\n+      \"rebuilt_path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-p