731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.command.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.command.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.command.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,15 @@\n+{\n+  \"name\": \"workflow-local-git-blob\",\n+  \"argv\": [\n+    \"git\",\n+    \"-C\",\n+    \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep\",\n+    \"show\",\n+    \"e643e9c8361bc4230bd400228eda6dfb87676bc6:.github/workflows/native-claude-qa-expansion-v1.yml\"\n+  ],\n+  \"started_at_utc\": \"2026-10-20T01:19:28.016230+00:00\",\n+  \"finished_at_utc\": \"2026-10-20T01:19:28.052304+00:00\",\n+  \"returncode\": 0,\n+  \"stdout_file\": \"workflow-local-git-blob.stdout\",\n+  \"stderr_file\": \"workflow-local-git-blob.stderr\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/remote-readiness/workflow-local-git-blob.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stderr","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stderr","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stderr?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731"},{"sha":"77d7e547b878c32fabff062aa5ffd70be0b3cf94","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/remote-readiness/workflow-local-git-blob.stdout","status":"added","additions":195,"deletions":0,"changes":195,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stdout","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stdout","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-local-git-blob.stdout?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,195 @@\n+name: Native Claude reserve expansion v1\n+run-name: native Claude reserve expansion / ${{ github.event_name }} / execute=${{ inputs.execute_expansion || false }}\n+\n+on:\n+  workflow_dispatch:\n+    inputs:\n+      execute_expansion:\n+        description: Execute the two frozen reserve task pairs, one per fresh runner\n+        type: boolean\n+        default: false\n+        required: true\n+\n+permissions:\n+  contents: read\n+  actions: read\n+\n+concurrency:\n+  group: native-claude-expansion-v1-${{ github.repository }}\n+  cancel-in-progress: false\n+\n+jobs:\n+  expansion:\n+    strategy:\n+      fail-fast: false\n+      max-parallel: 1\n+      matrix:\n+        task: [q002, q003]\n+    if: github.repository == 'Cuiyus/zvec-grep' && github.run_attempt == 1\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 145\n+    steps:\n+      - name: Set isolated runtime paths\n+        run: |\n+          cat >> \"$GITHUB_ENV\" <<EOF\n+          MAIN_ROOT=$RUNNER_TEMP/qa-main/benchmarks/swe-qa-bench\n+          REFERENCE_PREPARED_ROOT=$RUNNER_TEMP/qa-prepared\n+          PREPARED_GROUP_ROOT=$RUNNER_TEMP/qa-reserve-group\n+          REPAIR_ROOT=$RUNNER_TEMP/native-claude-expansion-v1-${{ matrix.task }}\n+          EOF\n+      - uses: actions/checkout@v6\n+        with:\n+          persist-credentials: false\n+      - uses: actions/setup-python@v6\n+        with:\n+          python-version: '3.12'\n+      - uses: actions/setup-node@v6\n+        with:\n+          node-version: '24'\n+      - name: Export the pinned upstream harness and source\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+        run: |\n+          set -euo pipefail\n+          expected=a424e0ce06868dc9ad8f142f57de59b8f9b58699\n+          test \"$(gh api repos/zvec-ai/zvec-grep/commits/main --jq .sha)\" = \"$expected\"\n+          git init \"$RUNNER_TEMP/qa-main-git\"\n+          git -C \"$RUNNER_TEMP/qa-main-git\" fetch --depth=1 https://github.com/zvec-ai/zvec-grep.git \"$expected\"\n+          test \"$(git -C \"$RUNNER_TEMP/qa-main-git\" rev-parse FETCH_HEAD)\" = \"$expected\"\n+          mkdir -p \"$RUNNER_TEMP/qa-main\" \"$REPAIR_ROOT\"\n+          git -C \"$RUNNER_TEMP/qa-main-git\" archive \"$expected\" benchmarks/swe-qa-bench benchmarks/shared/rust-package-cache.mjs | tar -x -C \"$RUNNER_TEMP/qa-main\"\n+          git init \"$RUNNER_TEMP/qa-zvec-git\"\n+          for revision in ec8a78ee08b14a0b8c94158ffc1de42cd3f97f6d e906168cc19378358d8fa1c1559f48e4b920aa37 68078e55e7ae9d705b8829b5d416e022060bebf7; do\n+            git -C \"$RUNNER_TEMP/qa-zvec-git\" fetch --depth=1 https://github.com/alibaba/zvec.git \"$revision\"\n+          done\n+          python -m pip install --disable-pip-version-check uv==0.9.17\n+          uv sync --project \"$MAIN_ROOT\" --frozen\n+          echo \"PYTHONPATH=$GITHUB_WORKSPACE/benchmarks/native-claude-qa-pilot:$GITHUB_WORKSPACE/benchmarks/opencode-qa-pilot:$MAIN_ROOT\" >> \"$GITHUB_ENV\"\n+          echo \"QA_MAIN_ROOT=$MAIN_ROOT\" >> \"$GITHUB_ENV\"\n+      - name: Verify immutable native inputs\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" -c 'import os; from pathlib import Path; from native_claude.integration import validate_inputs; validate_inputs(Path(os.environ[\"GITHUB_WORKSPACE\"]),Path(os.environ[\"MAIN_ROOT\"]))'\n+          cp benchmarks/native-claude-qa-pilot/inputs.json \"$REPAIR_ROOT/inputs.json\"\n+          cp benchmarks/native-claude-qa-pilot/decision.json \"$REPAIR_ROOT/decision.json\"\n+          docker version > \"$REPAIR_ROOT/docker-version.txt\"\n+      - name: Read the existing upstream Rust artifact\n+        uses: actions/download-artifact@v8\n+        with:\n+          repository: zvec-ai/zvec-grep\n+          run-id: 39221698769\n+          name: rust-native-linux-x64-gnu\n+          github-token: ${{ github.token }}\n+          path: ${{ runner.temp }}/rust-native\n+      - name: Derive the install-compatible archive without rebuilding Rust\n+        run: |\n+          set -euo pipefail\n+          export QA_ORIGINAL_TGZ=\"$RUNNER_TEMP/rust-native/zvec-zvec-grep-linux-x64-gnu-0.0.1.tgz\"\n+          echo \"QA_ORIGINAL_TGZ=$QA_ORIGINAL_TGZ\" >> \"$GITHUB_ENV\"\n+          \"$MAIN_ROOT/.venv/bin/python\" -m repair_v2.package \\\n+            --source \"$QA_ORIGINAL_TGZ\" --output \"$REPAIR_ROOT/zg-install.tgz\" \\\n+            --manifest \"$REPAIR_ROOT/package-derivation.json\"\n+      - name: Test live controller boundaries without providers\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" -m unittest discover \\\n+            -s benchmarks/native-claude-qa-pilot -p 'test_live.py' -v \\\n+            2>&1 | tee \"$REPAIR_ROOT/unit-tests.txt\"\n+      - name: Replay actual sync and background logs through corrected collector\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" -m unittest discover \\\n+            -s benchmarks/native-claude-qa-pilot -p 'test_accounting_v2.py' -v \\\n+            2>&1 | tee \"$REPAIR_ROOT/accounting-tests.txt\"\n+      - name: Test reserve preparation and actual task identity\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" -m unittest discover \\\n+            -s benchmarks/native-claude-qa-pilot -p 'test_expansion_v1.py' -v \\\n+            2>&1 | tee \"$REPAIR_ROOT/preparation-tests.txt\"\n+          \"$MAIN_ROOT/.venv/bin/python\" -m unittest discover \\\n+            -s benchmarks/native-claude-qa-pilot -p 'test_expansion_identity_v1.py' -v \\\n+            2>&1 | tee \"$REPAIR_ROOT/identity-tests.txt\"\n+          \"$MAIN_ROOT/.venv/bin/python\" -m unittest discover \\\n+            -s benchmarks/native-claude-qa-pilot -p 'test_expansion_live_v1.py' -v \\\n+            2>&1 | tee \"$REPAIR_ROOT/driver-tests.txt\"\n+      - name: Prepare the unchanged full q001 source-only image\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" benchmarks/opencode-qa-pilot/pilot.py \\\n+            --plan benchmarks/opencode-qa-pilot/experiment.json \\\n+            --repo-root \"$GITHUB_WORKSPACE\" --main-root \"$MAIN_ROOT\" \\\n+            prepare --zvec-repo \"$RUNNER_TEMP/qa-zvec-git\" --output \"$REFERENCE_PREPARED_ROOT\"\n+      - name: Prepare both original reserve tasks from the pinned template\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" -c 'import os; from pathlib import Path; import expansion_v1; expansion_v1.prepare(Path(os.environ[\"REFERENCE_PREPARED_ROOT\"]), Path(os.environ[\"RUNNER_TEMP\"])/\"qa-zvec-git\", Path(os.environ[\"PREPARED_GROUP_ROOT\"]))'\n+      - name: Check frozen plan and accepted offline evidence\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" benchmarks/native-claude-qa-pilot/expansion_live_v1.py \\\n+            --plan benchmarks/native-claude-qa-pilot/expansion-plan-v1.json --task \"${{ matrix.task }}\" \\\n+            --main-root \"$MAIN_ROOT\" --reference-prepared \"$REFERENCE_PREPARED_ROOT\" --prepared-group \"$PREPARED_GROUP_ROOT\" \\\n+            --candidate \"$REPAIR_ROOT/zg-install.tgz\" --output \"$REPAIR_ROOT/dry-run\" dry-run \\\n+            > \"$REPAIR_ROOT/preflight.log\"\n+          cp \"$REPAIR_ROOT/dry-run/execution.json\" \"$REPAIR_ROOT/preflight.json\"\n+      - name: Execute the selected reserve task pair\n+        if: github.event_name == 'workflow_dispatch' && inputs.execute_expansion == true\n+        env:\n+          ANTHROPIC_API_KEY: ${{ secrets.GLM_API_KEY }}\n+          ZVEC_GREP_API_KEY: ${{ secrets.QWEN_EMBEDDING_API_KEY }}\n+        run: |\n+          set -euo pipefail\n+          \"$MAIN_ROOT/.venv/bin/python\" benchmarks/native-claude-qa-pilot/expansion_live_v1.py \\\n+            --plan benchmarks/native-claude-qa-pilot/expansion-plan-v1.json --task \"${{ matrix.task }}\" \\\n+            --main-root \"$MAIN_ROOT\" --reference-prepared \"$REFERENCE_PREPARED_ROOT\" --prepared-group \"$PREPARED_GROUP_ROOT\" \\\n+            --candidate \"$REPAIR_ROOT/zg-install.tgz\" --output \"$REPAIR_ROOT/live\" run \\\n+            2>&1 | tee \"$REPAIR_ROOT/live.log\"\n+      - name: Collect retained answers, usage scopes and actual task identity\n+        if: always() && github.event_name == 'workflow_dispatch' && inputs.execute_expansion == true\n+        run: |\n+          set -euo pipefail\n+          if test -d \"$REPAIR_ROOT/live\" || test -f \"$REPAIR_ROOT/live-expansion-context.json\"; then\n+            \"$MAIN_ROOT/.venv/bin/python\" benchmarks/native-claude-qa-pilot/expansion_live_v1.py \\\n+              --plan benchmarks/native-claude-qa-pilot/expansion-plan-v1.json --task \"${{ matrix.task }}\" \\\n+              --main-root \"$MAIN_ROOT\" --reference-prepared \"$REFERENCE_PREPARED_ROOT\" --prepared-group \"$PREPARED_GROUP_ROOT\" \\\n+              --candidate \"$REPAIR_ROOT/zg-install.tgz\" --output \"$REPAIR_ROOT/live\" collect \\\n+              2>&1 | tee \"$REPAIR_ROOT/collect.log\"\n+          fi\n+      - name: Retain frozen plan and scan actual secrets before publication\n+        id: scan\n+        if: always()\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+          ANTHROPIC_API_KEY: ${{ secrets.GLM_API_KEY }}\n+          ZVEC_GREP_API_KEY: ${{ secrets.QWEN_EMBEDDING_API_KEY }}\n+        run: |\n+          set -euo pipefail\n+          mkdir -p \"$REPAIR_ROOT\"\n+          cp benchmarks/native-claude-qa-pilot/inputs.json \"$REPAIR_ROOT/inputs.json\"\n+          cp benchmarks/native-claude-qa-pilot/decision.json \"$REPAIR_ROOT/decision.json\"\n+          cp benchmarks/native-claude-qa-pilot/live-plan-v2.json \"$REPAIR_ROOT/live-plan-v2.json\"\n+          cp benchmarks/native-claude-qa-pilot/live-decision-v2.json \"$REPAIR_ROOT/live-decision-v2.json\"\n+          if test -f benchmarks/native-claude-qa-pilot/expansion-plan-v1.json; then cp benchmarks/native-claude-qa-pilot/expansion-plan-v1.json \"$REPAIR_ROOT/expansion-plan-v1.json\"; fi\n+          cp benchmarks/native-claude-qa-pilot/expansion-decision-v1.json \"$REPAIR_ROOT/expansion-decision-v1.json\"\n+          cp benchmarks/native-claude-qa-pilot/expansion-grader-contract-v1.json \"$REPAIR_ROOT/expansion-grader-contract-v1.json\"\n+          if test -f \"$PREPARED_GROUP_ROOT/group.json\"; then\n+            cp \"$PREPARED_GROUP_ROOT/group.json\" \"$REPAIR_ROOT/prepared-group.json\"\n+            for task in q002 q003; do\n+              cp \"$PREPARED_GROUP_ROOT/$task/prepared.json\" \"$REPAIR_ROOT/$task-prepared.json\"\n+              cp \"$PREPARED_GROUP_ROOT/$task/source-manifest.json\" \"$REPAIR_ROOT/$task-source-manifest.json\"\n+            done\n+          fi\n+          if test -x \"$MAIN_ROOT/.venv/bin/python\"; then\n+            \"$MAIN_ROOT/.venv/bin/python\" -m zg_bench.ci.secret_scan --secret-env GH_TOKEN --secret-env ANTHROPIC_API_KEY --secret-env ZVEC_GREP_API_KEY --root \"$REPAIR_ROOT\"\n+          else\n+            exit 1\n+          fi\n+      - uses: actions/upload-artifact@v4\n+        if: always() && steps.scan.outcome == 'success'\n+        with:\n+          name: native-claude-expansion-v1-${{ github.run_id }}-${{ matrix.task }}\n+          path: ${{ runner.temp }}/native-claude-expansion-v1-${{ matrix.task }}/\n+          include-hidden-files: true\n+          if-no-files-found: error\n+          retention-days: 90"},{"sha":"46f7bca2bbe5b8ddc0efe95fe2028549fe436e07","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/remote-readiness/workflow-registration.command.json","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-registration.command.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-registration.command.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fremote-readiness%2Fworkflow-registration.command.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,13 @@\n+{\n+  \"name\": \"workflow-registration\",\n+  \"argv\": [\n+    \"gh\",\n+    \"api\",\n+    \"repos/Cuiyus/zvec-grep/actions/workflows/native-claude-qa-expansion-v1.yml\"\n+  ],\n+  \"started_at_utc\": \"2026-10-20T01:18:25.100410+00:00\",\n+  \"finished_at_utc\": \"2026-10-20T01:18:26.995683+00:00\",\n+  \"returncode\": 1,\n+  \"stdout_file\": \"workflow-registration.stdout\",\n+  \"stderr_file\": \"workflow-registration.stderr\"\n+}"},{"sha":"124b889f2fb20f66a150cce1d8179cc7c2c6d98b","filename":"benchmarks/native-claude-qa-pilot/provenance/native-ex