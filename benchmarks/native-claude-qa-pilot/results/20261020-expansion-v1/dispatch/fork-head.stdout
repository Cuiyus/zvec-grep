{"sha":"bbc15485ca317427f6b19cab4dc449c50d3ef731","node_id":"C_kwDOT_LafNoAKGJiYzE1NDg1Y2EzMTc0MjdmNmIxOWNhYjRkYzQ0OWM1MGQzZWY3MzE","commit":{"author":{"name":"cuiyus","email":"cuiyushuai.cys@alibaba-inc.com","date":"2026-10-20T01:25:30Z"},"committer":{"name":"cuiyus","email":"cuiyushuai.cys@alibaba-inc.com","date":"2026-10-20T01:25:30Z"},"message":"Freeze native Claude reserve task expansion and provider-free preflight","tree":{"sha":"4d8d2a96e87fdd58bf4bfac8ccb7f73d2bafd6a9","url":"https://api.github.com/repos/Cuiyus/zvec-grep/git/trees/4d8d2a96e87fdd58bf4bfac8ccb7f73d2bafd6a9"},"url":"https://api.github.com/repos/Cuiyus/zvec-grep/git/commits/bbc15485ca317427f6b19cab4dc449c50d3ef731","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Cuiyus/zvec-grep/commits/bbc15485ca317427f6b19cab4dc449c50d3ef731","html_url":"https://github.com/Cuiyus/zvec-grep/commit/bbc15485ca317427f6b19cab4dc449c50d3ef731","comments_url":"https://api.github.com/repos/Cuiyus/zvec-grep/commits/bbc15485ca317427f6b19cab4dc449c50d3ef731/comments","author":{"login":"Cuiyus","id":42903451,"node_id":"MDQ6VXNlcjQyOTAzNDUx","avatar_url":"https://avatars.githubusercontent.com/u/42903451?v=4","gravatar_id":"","url":"https://api.github.com/users/Cuiyus","html_url":"https://github.com/Cuiyus","followers_url":"https://api.github.com/users/Cuiyus/followers","following_url":"https://api.github.com/users/Cuiyus/following{/other_user}","gists_url":"https://api.github.com/users/Cuiyus/gists{/gist_id}","starred_url":"https://api.github.com/users/Cuiyus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cuiyus/subscriptions","organizations_url":"https://api.github.com/users/Cuiyus/orgs","repos_url":"https://api.github.com/users/Cuiyus/repos","events_url":"https://api.github.com/users/Cuiyus/events{/privacy}","received_events_url":"https://api.github.com/users/Cuiyus/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Cuiyus","id":42903451,"node_id":"MDQ6VXNlcjQyOTAzNDUx","avatar_url":"https://avatars.githubusercontent.com/u/42903451?v=4","gravatar_id":"","url":"https://api.github.com/users/Cuiyus","html_url":"https://github.com/Cuiyus","followers_url":"https://api.github.com/users/Cuiyus/followers","following_url":"https://api.github.com/users/Cuiyus/following{/other_user}","gists_url":"https://api.github.com/users/Cuiyus/gists{/gist_id}","starred_url":"https://api.github.com/users/Cuiyus/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Cuiyus/subscriptions","organizations_url":"https://api.github.com/users/Cuiyus/orgs","repos_url":"https://api.github.com/users/Cuiyus/repos","events_url":"https://api.github.com/users/Cuiyus/events{/privacy}","received_events_url":"https://api.github.com/users/Cuiyus/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e643e9c8361bc4230bd400228eda6dfb87676bc6","url":"https://api.github.com/repos/Cuiyus/zvec-grep/commits/e643e9c8361bc4230bd400228eda6dfb87676bc6","html_url":"https://github.com/Cuiyus/zvec-grep/commit/e643e9c8361bc4230bd400228eda6dfb87676bc6"}],"stats":{"total":46091,"additions":46068,"deletions":23},"files":[{"sha":"8a7e0e5267f19987ec094790a3f2b0d979cede5f","filename":".github/workflows/native-claude-qa-expansion-v1.yml","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/.github%2Fworkflows%2Fnative-claude-qa-expansion-v1.yml","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/.github%2Fworkflows%2Fnative-claude-qa-expansion-v1.yml","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/.github%2Fworkflows%2Fnative-claude-qa-expansion-v1.yml?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -2,6 +2,19 @@ name: Native Claude reserve expansion v1\n run-name: native Claude reserve expansion / ${{ github.event_name }} / execute=${{ inputs.execute_expansion || false }}\n \n on:\n+  push:\n+    branches: [dev/opencode-qa-repair-v2]\n+    paths:\n+      - 'benchmarks/native-claude-qa-pilot/expansion_live_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/test_expansion_live_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/expansion_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/test_expansion_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/expansion_identity_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/test_expansion_identity_v1.py'\n+      - 'benchmarks/native-claude-qa-pilot/expansion-plan-v1.json'\n+      - 'benchmarks/native-claude-qa-pilot/expansion-decision-v1.json'\n+      - 'benchmarks/native-claude-qa-pilot/expansion-grader-contract-v1.json'\n+      - '.github/workflows/native-claude-qa-expansion-v1.yml'\n   workflow_dispatch:\n     inputs:\n       execute_expansion:"},{"sha":"08ff8942839eb3fc7515955ab7d7ae2e6841aae0","filename":"benchmarks/native-claude-qa-pilot/README.md","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2FREADME.md","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2FREADME.md","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2FREADME.md?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -28,8 +28,8 @@ All development CI runs on `Cuiyus/zvec-grep`. Existing upstream binaries are re\n \n [Revision 2 evidence](results/20261020-offline-r2/summary.json) retains the successful native sequences and original failed guidance assertion. The [live runner](live.py), [prospective plan](live-plan-v2.json), [decision](live-decision-v2.json) and [host-only grading contract](grader-contract-v1.json) define the completed one-pair experiment. Any confirmation requires a separate frozen decision.\n \n-The preparation-only [reserve-task adapter](expansion_v1.py) exports the original q002/q003 pair together, reuses the pinned q001 image/verifier templates, and binds each original question, full source inventory, suite selection and both Harbor task hashes. `prepare(reference_prepared, zvec_repo, output)` requires a fresh independent output; `validate(prepared_group, reference_prepared)` checks the complete group. Six local tests cover cross-task substitution, altered or missing content, hidden rubric files and template/metadata tampering; actual source exports and native suite loading also passed. Preparation produces no experiment result. The [grading contract](expansion-grader-contract-v1.json) remains a host-only prospective draft.\n+The preparation-only [reserve-task adapter](expansion_v1.py) exports the original q002/q003 pair together, reuses the pinned q001 image/verifier templates, and binds each original question, full source inventory, suite selection and both Harbor task hashes. `prepare(reference_prepared, zvec_repo, output)` requires a fresh independent output; `validate(prepared_group, reference_prepared)` checks the complete group. Six local tests cover cross-task substitution, altered or missing content, hidden rubric files and template/metadata tampering; actual source exports and native suite loading also passed. Preparation produces no experiment result. The [grading contract](expansion-grader-contract-v1.json) is frozen before execution, with its original scoring semantics unchanged.\n \n-The separate [read-only trial identity check](expansion_identity_v1.py) binds the actual command, native task hashes, before/after source inventories and exact answer SHA to that prepared task. Its caller must supply a prospectively recorded execution-host prepared path and profile order. Seven tests cover reversed order, substituted tasks, missing/extra trials and mismatched evidence, including rejection of the retained real q001 run as q002. A future execution plan must combine this check with the unchanged native collector and independent source-scope review; no reserve-task solver execution has occurred.\n+The separate [read-only trial identity check](expansion_identity_v1.py) binds the actual command, native task hashes, before/after source inventories and exact answer SHA to that prepared task. Its caller must supply a prospectively recorded execution-host prepared path and profile order. Seven tests cover reversed order, substituted tasks, missing/extra trials and mismatched evidence, including rejection of the retained real q001 run as q002. The expansion plan combines this check with the unchanged native collector and independent source-scope review.\n \n-The prospective [two-task driver](expansion_live_v1.py) reuses the original native execution and collection bodies and requires both native structural validity and task identity validity. Its [manual-only workflow](../../.github/workflows/native-claude-qa-expansion-v1.yml) has not been dispatched. The [decision](expansion-decision-v1.json) remains a draft: no executable expansion plan is supplied, and execution requires the completed q001 confirmation conclusion, a separate host decision within the existing user goal, a fresh upstream check and frozen grading/control references. The original q002/q003 questions and their earlier adverse development results remain unchanged; this is preparation for a possible next phase, not a new result or a fresh holdout set.\n+The [frozen expansion plan](expansion-plan-v1.json) and [decision](expansion-decision-v1.json) schedule exactly one baseline/zg pair for each original reserve: q002 baseline→zg and q003 zg→baseline, on separate fresh fork CI runners, with no retries or replacements. The [two-task driver](expansion_live_v1.py) reuses the original native execution and collection bodies and requires both native structural validity and task identity validity. The [workflow](../../.github/workflows/native-claude-qa-expansion-v1.yml) runs provider-free prechecks on restricted branch/path pushes; actual solver execution requires a separate explicit dispatch after the same frozen commit passes those checks. The decision retains the negative q001 confirmation conclusion and fresh upstream verification. Both tasks must independently satisfy the original quality, non-inferiority, reported-input and source-scope gates; no pooling with q001 or selective subset is allowed. The original questions and earlier adverse development results remain unchanged. These are previously exercised tasks, not fresh holdouts, and the frozen plan itself establishes no favorable result."},{"sha":"012aa93f33837e1e10474170d1aceab503c6fed8","filename":"benchmarks/native-claude-qa-pilot/expansion-decision-v1.json","status":"modified","additions":36,"deletions":16,"changes":52,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-decision-v1.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-decision-v1.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-decision-v1.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -2,10 +2,10 @@\n   \"schema_version\": 1,\n   \"protocol_id\": \"native-claude-reserves-expansion-v1\",\n   \"phase\": \"native-claude-reserves-development\",\n-  \"status\": \"draft_pending_confirmation_audit\",\n-  \"frozen\": false,\n-  \"paid_execution_authorized\": false,\n-  \"purpose\": \"Prepare a bounded comparison of transfer across the original two reserve tasks using the native Claude stack. This draft authorizes no solver/provider or CI execution.\",\n+  \"status\": \"approved_for_two_fresh_task_pairs\",\n+  \"frozen\": true,\n+  \"paid_execution_authorized\": true,\n+  \"purpose\": \"Run one native Claude baseline/zg pair for each of the original q002 and q003 reserve tasks, preserving the whole prior selection. Test transfer across different task mechanisms after the completed q001 confirmation failed; this is not further q001 sampling or a positive-result filter.\",\n   \"base_plan\": {\n     \"path\": \"benchmarks/native-claude-qa-pilot/live-plan-v2.json\",\n     \"sha256\": \"b4e8fb15b6cae82a9083add53ad7c04e67673720f7a50825fde587b7538ad026\"\n@@ -15,18 +15,18 @@\n     \"sha256\": \"e874a1d6509967f76f739ac99f70910c5a5a0a6c590514aac8de7cb4e2bf0e91\"\n   },\n   \"prepared\": {\n-    \"scope\": \"Local preparation evidence; future execution must reproduce or retain and verify these exact identities before authorization.\",\n+    \"scope\": \"Preparatory exports with verified identities. Each fresh Linux job must rebuild and validate the entire group, actual native task selection and the frozen runtime before its solver step.\",\n     \"group\": {\n-      \"path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/native-expansion-prepared-v1/group.json\",\n+      \"path\": \"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/prepared/group.json\",\n       \"sha256\": \"4e02167d7352670d2c78d6332427e7b9d709a96d38249ed91d3b493af3ef9c23\"\n     },\n     \"task_metadata\": {\n       \"q002\": {\n-        \"path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/native-expansion-prepared-v1/q002/prepared.json\",\n+        \"path\": \"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/prepared/q002/prepared.json\",\n         \"sha256\": \"9325f86f25df7afd02fe86eaf88303b2f8d1fec78f7acbb066bb850280af1ef0\"\n       },\n       \"q003\": {\n-        \"path\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/native-expansion-prepared-v1/q003/prepared.json\",\n+        \"path\": \"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/prepared/q003/prepared.json\",\n         \"sha256\": \"b72eae05f6b03317ac3d7f1bc52e3c603a06805a8ea0bf6280516464e04f10a2\"\n       }\n     }\n@@ -55,8 +55,8 @@\n   \"configuration\": \"Inherit the base native model, agent/version/effort, endpoint, runtime, Rust candidate, budget/time limits, embedding configuration, native guidance and execution/accounting behavior unchanged. For each task use its own original frozen source commit, question and rubric from the pinned dataset; do not substitute q001 data or change a prompt.\",\n   \"grading_contract\": {\n     \"path\": \"benchmarks/native-claude-qa-pilot/expansion-grader-contract-v1.json\",\n-    \"sha256\": \"af9744b6b9775a2d5fee9ef7942296f654cfead9f6e4114f0933300bcae26ef0\",\n-    \"required_before_execution\": \"Host review and a separately recorded prospective freeze before any new expansion answers. Host-only: never source/image/MCP index/solver prompt. Preserve every original task-specific quality/core/citation/contradiction gate.\"\n+    \"sha256\": \"0b178317d8eb23ca021a1e682dc1b9f5328a829e2057ff23b097816482cfb2ed\",\n+    \"required_before_execution\": \"The original host-only task grading semantics have been independently reviewed and frozen before expansion execution. Never expose rubric, provenance or prior results to the solver.\"\n   },\n   \"primary\": {\n     \"name\": \"reported-input benefit across both original reserve tasks\",\n@@ -79,25 +79,45 @@\n   },\n   \"execution_prerequisites\": {\n     \"current_q001_confirmation_run_id\": 39343873279,\n-    \"confirmation_conclusion\": null,\n+    \"confirmation_conclusion\": {\n+      \"path\": \"benchmarks/native-claude-qa-pilot/results/20261020-confirmation-v1/summary.json\",\n+      \"sha256\": \"34ada8bd8a698f7119374e8c7b4aa77a62ba6c0e78ba6234dc31156f16879790\"\n+    },\n     \"confirmation_requirement\": \"Both predeclared q001 confirmation pairs must finish and be retained with independent execution/source audits, blinded grades and final conclusion. Bind the exact conclusion/report path and SHA here before any expansion execution; no positive outcome is assumed by this draft.\",\n     \"approval_requirement\": \"A subsequent host execution decision made by root within the active user goal’s existing authorization is required after inspecting the retained confirmation conclusion. This is not a request for additional user confirmation. Once the predeclared prerequisites are satisfied, root may make and record that decision and continue. Preparation/driver work and this draft alone are not paid-run authorization.\",\n-    \"upstream_verification\": null,\n+    \"upstream_verification\": {\n+      \"repo\": \"zvec-ai/zvec-grep\",\n+      \"ref\": \"main\",\n+      \"sha\": \"a424e0ce06868dc9ad8f142f57de59b8f9b58699\",\n+      \"checked_at_utc\": \"2026-10-20T01:18:27.457207+00:00\",\n+      \"evidence\": {\n+        \"path\": \"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/remote-readiness/upstream-main-ls-remote.command.json\",\n+        \"sha256\": \"70826a959400327815a8c5e8a7190edb4fb0dbfe8d53be30d4a6ecb7c9ee9bc0\"\n+      },\n+      \"stdout_sha256\": \"f121f56d9ff23983b3110aa393dc5926fe62932900ceeb60e7c7773d133d9057\"\n+    },\n     \"upstream_requirement\": \"Record a fresh current-upstream check against a424e0ce06868dc9ad8f142f57de59b8f9b58699 before authorization; do not silently move the base revision.\",\n-    \"frozen_execution_plan\": null,\n+    \"frozen_execution_plan\": {\n+      \"path\": \"benchmarks/native-claude-qa-pilot/expansion-plan-v1.json\",\n+      \"binding\": \"The final plan pins this decision; the dispatched commit and exclusive execution sidecar bind the exact plan SHA, avoiding a circular hash.\"\n+    },\n     \"freeze_requirement\": \"After prerequisites and review, separately freeze the final plan/decision, host grading contract and executable workflow/driver hashes. The runner must reject this draft status/frozen=false, missing prerequisite bindings or mismatched inputs.\",\n-    \"host_execution_decision\": null\n+    \"host_execution_decision\": \"Approved by root after inspecting the retained negative q001 conclusion: c01 baseline9/zg7 fails quality and score non-inferiority; c02 8/8 passes; whole confirmation fails. End q001 sampling. Run exactly the original q002 baseline->zg and q003 zg->baseline pairs once each to assess native-stack transfer across different issues. Keep all earlier adverse results and every new result. Before the one execute=true dispatch, require the same frozen commit to pass fork-only provider-free CI preflight; each paid job also rechecks all local gates before its solver step. No retries, replacement, pooling or rubric/prompt change after outcomes.\"\n   },\n   \"stopping\": \"Stop after the two scheduled task pairs and their independent audits, retaining all failures and partial results. Cleanup uncertainty blocks the next slot on that runner. No retries, favorable replacements or post-outcome changes; any new phase requires its own prospective decision.\",\n   \"limits\": \"Two purposively selected, previously observed development tasks do not establish a representative favorable benchmark set, contamination freedom, immutable model weights or broad causal benefit.\",\n   \"ci_scope\": \"Any later approved development CI is restricted to Cuiyus/zvec-grep. Upstream access is read-only source/existing artifact retrieval.\",\n-  \"current_confirmation_isolation\": \"The current q001 confirmation protocol, schedule, answers and results are untouched. This draft was prepared without reading its answers.\",\n+  \"current_confirmation_isolation\": \"The completed q001 confirmation and its original execution/grading files remain unchanged. This expansion draft was prepared before seeing its answers; the present separate host approval explicitly binds the completed negative conclusion.\",\n   \"base_plan_sha256\": \"b4e8fb15b6cae82a9083add53ad7c04e67673720f7a50825fde587b7538ad026\",\n   \"prepared_group\": {\n     \"group_sha256\": \"4e02167d7352670d2c78d6332427e7b9d709a96d38249ed91d3b493af3ef9c23\",\n     \"metadata_sha256\": {\n       \"q002\": \"9325f86f25df7afd02fe86eaf88303b2f8d1fec78f7acbb066bb850280af1ef0\",\n       \"q003\": \"b72eae05f6b03317ac3d7f1bc52e3c603a06805a8ea0bf6280516464e04f10a2\"\n     }\n-  }\n+  },\n+  \"frozen_at_utc\": \"2026-10-20T01:21:54.222603+00:00\",\n+  \"authorization_basis\": \"The active user goal authorizes continued bounded development toward a favorable e2e benchmark set after both requested single-case minimum routes. Root approves these two predetermined task pairs within that authorization; no further user confirmation is required.\",\n+  \"previous_draft_sha256\": \"c7f088587a2c097d0fe40b7bc9425bdf97922ddfff6df3f0193fdf5bfefe00e3\",\n+  \"workflow_entry\": \"Restricted push events on dev/opencode-qa-repair-v2 perform provider-free tests/preparation/dry-run and register the workflow, using the already observed confirmation-workflow precedent. Solver and collect steps require workflow_dispatch with execute_expansion=true; its default is false. Root will inspect the preflight and registered workflow before one paid dispatch. All jobs additionally require the fork repository and run_attempt1.\"\n }"},{"sha":"afcdc3f2359470d2b72a0698abf4f43a1ccf8a92","filename":"benchmarks/native-claude-qa-pilot/expansion-grader-contract-v1.json","status":"modified","additions":13,"deletions":4,"changes":17,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-grader-contract-v1.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-grader-contract-v1.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fexpansion-grader-contract-v1.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -1,7 +1,7 @@\n {\n   \"schema_version\": 1,\n-  \"status\": \"draft_for_prospective_expansion\",\n-  \"frozen\": false,\n+  \"status\": \"frozen_for_native_expansion_v1\",\n+  \"frozen\": true,\n   \"purpose\": \"Host-only prospective interpretation of the original q002/q003 grading contracts; no execution authorization and no historical regrading.\",\n   \"dataset\": {\n     \"path\": \"benchmarks/zvec-issue-qa/dataset-expansion-v1.json\",\n@@ -35,7 +35,7 @@\n     }\n   },\n   \"readiness_report_sha256\": \"d1e77db27898472d58310ff86af52d046f1bea052ce316a4e04b2f09b5c69144\",\n-  \"distribution\": \"Host review/grading only. Never copy this file, rubric, reference answer, provenance or prior results into solver source, image, MCP index, system/user prompt or agent guidance. This draft does not apply to the current q001 confirmation.\",\n+  \"distribution\": \"Host review/grading only. Never copy this file, rubric, reference answer, provenance or prior results into solver source, image, MCP index, system/user prompt or agent guidance. This host contract does not apply to the current q001 confirmation.\",\n   \"common_rules\": [\n     \"Freeze the final host contract before any future expansion answer is seen. Use randomized exact-byte final answers, the corresponding original question/rubric and frozen pre-fix source; exclude condition/pair labels, resource metrics, trajectories and prior answers/scores from the grader packet.\",\n     \"The pinned rubric remains authoritative for points, success gates, partial credit, contradictions and evidence. Keep maximum10/minimum8 and the original task-specific core requirements. Use integer points only; equivalent correct causal wording and sufficient source spans are accepted.\",\n@@ -93,5 +93,14 @@\n     \"reviewer_added\": \"Retain supplemental source verification separately with this label. It may explain the review but cannot supply missing final-answer coverage or core citation evidence.\",\n     \"preservation\": \"Keep original answer and grader-report bytes. Any attribution correction is a separate annotated record, not a silent rewrite or opportunity to choose a different score.\"\n   },\n-  \"draft_review_note\": \"Host review accepts the q002 C3 compound control group and resolves the C4 incomplete-preservation case as1 prospectively. The contract remains a draft until a separate expansion decision freezes it. It is not retroactive and changes no rubric bytes or full-credit/core threshold.\"\n+  \"frozen_at_utc\": \"2026-10-20T01:21:54.222603+00:00\",\n+  \"historical_draft_review_note\": \"Host review accepts the q002 C3 compound control group and resolves the C4 incomplete-preservation case as1 prospectively. The contract remains a draft until a separate expansion decision freezes it. It is not retroactive and changes no rubric bytes or full-credit/core threshold.\",\n+  \"freeze_provenance\": {\n+    \"previous_draft_sha256\": \"af9744b6b9775a2d5fee9ef7942296f654cfead9f6e4114f0933300bcae26ef0\",\n+    \"review\": {\n+      \"path\": \"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/grading-contract-review.json\",\n+      \"sha256\": \"ee552c67c49d8ed39a46f30549c229eb00fa7530e63ba2a6877d3abcfe6fb546\"\n+    },\n+    \"transition\": \"Only freeze status/provenance and draft wording changed. Original criterion semantics, inputs and scoring gates are unchanged. The historical draft note describes its earlier status; this frozen status supersedes it. Source annotation limits in the review require actual-source verification, already required by the unchanged citation rules.\"\n+  }\n }"},{"sha":"dc23e5b5105894bed6c4b8407e2f0b9261a84d16","filename":"benchmarks/native-claude-qa-pilot/expansion-plan-v1.json","status":"added","additions":112,"deletions":0,"changes":112,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%