ytes\": 8554\n+    },\n+    {\n+      \"path\": \"local-preflight/workflow-validation.json\",\n+      \"sha256\": \"27e5b49e485e879af09e4c4b50f4c2dfb7a06fa160f5c5fa4500b341c5e3a841\",\n+      \"bytes\": 1805\n+    }\n+  ]\n+}"},{"sha":"aa3dbe90fab96f675dd7c2aead320f0d607c3e63","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/grading-contract-review.json","status":"added","additions":874,"deletions":0,"changes":874,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fgrading-contract-review.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fgrading-contract-review.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fgrading-contract-review.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,874 @@\n+{\n+  \"schema_version\": 1,\n+  \"review_type\": \"prospective_grading_contract_read_only_static_review\",\n+  \"reviewer_kind\": \"delegated_model_review_not_official_SWE_QA_or_human_grading\",\n+  \"created_at_utc\": \"2026-10-20T01:20:03.502654+00:00\",\n+  \"decision\": \"pass_for_separate_freeze\",\n+  \"review_passed\": true,\n+  \"contract_frozen_at_review\": false,\n+  \"blocking_findings\": [],\n+  \"material_scoring_contradictions_found\": false,\n+  \"inputs\": [\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/expansion-grader-contract-v1.json\",\n+      \"sha256\": \"af9744b6b9775a2d5fee9ef7942296f654cfead9f6e4114f0933300bcae26ef0\",\n+      \"bytes\": 9189\n+    },\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/dataset-expansion-v1.json\",\n+      \"sha256\": \"e874a1d6509967f76f739ac99f70910c5a5a0a6c590514aac8de7cb4e2bf0e91\",\n+      \"bytes\": 4770\n+    },\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/tasks/q002/instruction.md\",\n+      \"sha256\": \"5efcf9a84884cdc02647167ee794dca0ae3eda0a9bd04c13ef4c5909169326c6\",\n+      \"bytes\": 1729\n+    },\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/evaluator/q002.json\",\n+      \"sha256\": \"e04ddba1591d26f0a100655cc8ff63b6468ff59190dda0ef69d2ae1ed73c2ada\",\n+      \"bytes\": 19398\n+    },\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/tasks/q003/instruction.md\",\n+      \"sha256\": \"2aeed87cbe2a570b242a9659d50fab0d279122a234d1ee9aaa5352787e00f669\",\n+      \"bytes\": 1720\n+    },\n+    {\n+      \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/evaluator/q003.json\",\n+      \"sha256\": \"b3d1f98d690254b9b53ceece693b11a86de35d7d9dcdf49e31c2735d7c115682\",\n+      \"bytes\": 45020\n+    }\n+  ],\n+  \"checks\": [\n+    {\n+      \"id\": \"input_pinning\",\n+      \"status\": \"pass\",\n+      \"finding\": \"The original q002/q003 questions and evaluators match both dataset pins and contract pins; the dataset matches its contract pin. No question or rubric bytes were modified.\"\n+    },\n+    {\n+      \"id\": \"totals_and_success_gates\",\n+      \"status\": \"pass\",\n+      \"finding\": \"Both criteria totals are 10 and minimum success is 8. q002 requires C1/C2/C4 at 2 each plus actual supporting pre-fix citations and zero critical contradictions. q003 requires a nonempty final answer, C2/C3 at 2 each, both units of each core criterion cited, and no substantiated disqualifying assertion or critical contradiction. The common rules preserve the authoritative rubric even where the contract summarizes it.\"\n+    },\n+    {\n+      \"id\": \"q002_C1_C2\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q002:E05\",\n+        \"q002:E06\",\n+        \"q002:E07\",\n+        \"q002:E08\",\n+        \"q002:E09\",\n+        \"q002:E11\"\n+      ],\n+      \"finding\": \"Original 0/1/2 anchors remain authoritative. The count-zero result returns an engaged empty candidate vector after indexed-filter/result reset. FTS uses a plain candidate vector and intersects only nonempty candidates, while remaining delete/forward filters are still independently effective. A non-null empty bitmap does not avoid the handoff defect.\"\n+    },\n+    {\n+      \"id\": \"q002_C3_original_units\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q002:E01\",\n+        \"q002:E02\",\n+        \"q002:E05\",\n+        \"q002:E06\",\n+        \"q002:E09\",\n+        \"q002:E10\",\n+        \"q002:E11\",\n+        \"q002:E16\",\n+        \"q002:E17\"\n+      ],\n+      \"finding\": \"The contract preserves the two original one-point groups: empty scalar-only inverted iteration; and retained unindexed forward filtering together with meaningful nonempty restrictions explaining positive/disjoint controls. The second group stays compound and has no fractional subdivision. One correct causal account can cover both nonempty outcomes, without requiring independent explanations for each query or candidate extraction for all controls. Merely reciting prompt ID sets does not supply causal explanation.\"\n+    },\n+    {\n+      \"id\": \"q002_C4_full_and_partial\",\n+      \"status\": \"pass_with_prospective_interpretation\",\n+      \"evidence_ids\": [\n+        \"q002:E05\",\n+        \"q002:E06\",\n+        \"q002:E07\",\n+        \"q002:E08\",\n+        \"q002:E09\",\n+        \"q002:E13\"\n+      ],\n+      \"finding\": \"Full credit still requires absent/unrestricted, explicit-empty/reject-all and nonempty/restricted behavior end to end, consumption/reset handling, ordinary unfiltered queries, and remaining delete/forward preservation. The frozen pre-fix source supports this requirement. The declared extra partial boundary gives 1, never 2, to an otherwise correct source-grounded repair that leaves only remaining-filter preservation unexplained. This is an explicit prospective interpretation of incomplete repair reasoning, not a verbatim original partial anchor and not a changed full-credit/core gate. It applies to every future blinded answer symmetrically. No missing preservation may be supplied from reviewer-added code.\"\n+    },\n+    {\n+      \"id\": \"q002_C5_original_units\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q002:E09\",\n+        \"q002:E10\",\n+        \"q002:E13\"\n+      ],\n+      \"finding\": \"The original two one-point groups are retained: zero-match indexed-scalar plus matching-FTS with expected empty IDs and a scalar-only/unindexed control; then no-scalar, nonempty overlap and nonempty disjoint expectations preserving valid results/topk/remaining-filter behavior. Each point requires one complete original group. Described checks suffice; no execution, exact upstream name, executable code or extra topk-size matrix is introduced.\"\n+    },\n+    {\n+      \"id\": \"q003_C2_original_units\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q003:E04\",\n+        \"q003:E05\",\n+        \"q003:E06\",\n+        \"q003:E08\",\n+        \"q003:E21\",\n+        \"q003:E22\",\n+        \"q003:E23\",\n+        \"q003:E24\",\n+        \"q003:E25\"\n+      ],\n+      \"finding\": \"maintenance_branch.1 retains the physical/live denominator, strict threshold, 3/28 nonpurging branch and larger-deletion coordinated branch. maintenance_branch.2 retains sealing, single-segment CreateVectorIndexTask/create_vector_index without a forward purge, existing default FLAT memory then persisted storage, and the initially unset requested-HNSW built flag. Source supports both; neither is replaced with a shorter summary.\"\n+    },\n+    {\n+      \"id\": \"q003_C3_original_units\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q003:E07\",\n+        \"q003:E08\",\n+        \"q003:E09\",\n+        \"q003:E10\",\n+        \"q003:E11\"\n+      ],\n+      \"finding\": \"broken_mapping.1 retains the row-deletion filter passed through Merge and the reducer skipping tombstones while assigning dense survivor keys. broken_mapping.2 retains physical forward/doc_ids positions and block counts/metadata plus their explicit mismatch with dense vector keys. Each original unit remains indivisible at one point.\"\n+    },\n+    {\n+      \"id\": \"q003_noncore_compound_units\",\n+      \"status\": \"pass\",\n+      \"evidence_ids\": [\n+        \"q003:E01\",\n+        \"q003:E02\",\n+        \"q003:E03\",\n+        \"q003:E12\",\n+        \"q003:E13\",\n+        \"q003:E14\",\n+        \"q003:E15\",\n+        \"q003:E16\",\n+        \"q003:E17\",\n+        \"q003:E18\",\n+        \"q003:E19\",\n+        \"q003:E20\",\n+        \"q003:E26\",\n+        \"q003:E27\",\n+        \"q003:E28\",\n+        \"q003:E29\"\n+      ],\n+      \"finding\": \"C1 and C4-C8 remain their original single-point compound units, with 0 for materially incomplete units. C7 still requires logical read filtering; C8 still requires an independent known-direction oracle plus correct live ID and vector payload. Optional upsert, reopening/variant matrices, quantization, universal ANN guarantees and ideal-decimal exactly-30% behavior are not promoted to requirements.\"\n+    },\n+    {\n+      \"id\": \"citations_and_origin\",\n+      \"status\": \"pass\",\n+      \"finding\": \"All 46 curated file and span hashes match the supplied pre-fix snapshots. Actual content supports the criterion evidence sets. Equivalent sufficient spans are accepted, literal curated ranges are not required, and reviewer-added context cannot be credited as an answer citation. Every q003 C2/C3 unit requires an actual answer citation, verified location and support explanation. The contract does not weaken that gate.\"\n+    },\n+    {\n+      \"id\": \"contradictions_and_symmetry\",\n+      \"status\": \"pass\",\n+      \"finding\": \"q002 explicit critical contradictions remain authoritative; q003 disqualification assertions require an exact answer quote, violated ID, pre-fix evidence and rationale. Criterion IDs and disqualifier IDs are separate namespaces. Omission alone is not affirmative contradiction, while missing compound elements are scored by the original unit/anchor and mandatory gate. No model/condition label or outcome-dependent exception appears in the contract.\"\n+    },\n+    {\n+      \"id\": \"no_new_execution_requirement\",\n+      \"status\": \"pass\",\n+      \"finding\": \"q002 explicitly requires neither code changes nor tests; q003 forbids editing/executing the repository. The contract accepts described regression checks and preserves source inference versus executed evidence. It adds no execution requirement, failure-propagation requirement or optional test matrix.\"\n+    },\n+    {\n+      \"id\": \"prospective_freeze_boundary\",\n+      \"status\": \"pass_pending_separate_freeze\",\n+      \"finding\": \"Reviewed contract has frozen=false and draft status. This review is not the freeze and grants no solver execution authorization. Root must freeze a separately recorded version before any new expansion answer is seen. Both selected tasks and all outcomes must be retained; no historical regrading is performed.\"\n+    }\n+  ],\n+  \"source_evidence_hash_checks\": [\n+    {\n+      \"task_id\": \"q002\",\n+      \"evidence_id\": \"E01\",\n+      \"source_root\": \"/Users/cc/workspace/zvec-grep/output/claude-qwen-qa-pilot-20261019/main-agent-pilot/native-expansion-prepared-v1/q002/tasks/zvec-q002/environment/source\",\n+      \"path\": \"src/db/sqlengine/analyzer/query_node_walker.cc\",\n+      \"start_line\": 213,\n+      \"end_line\": 298,\