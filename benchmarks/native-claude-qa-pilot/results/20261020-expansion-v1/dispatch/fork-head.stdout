: true\n+          },\n+          {\n+            \"id\": \"E06\",\n+            \"path\": \"src/db/sqlengine/planner/doc_filter.cc\",\n+            \"start_line\": 109,\n+            \"end_line\": 140,\n+            \"span_sha256\": \"8ce71a670b127abf9bf65f4cbeeefdd60c2f05917fbb6a65befb255a03d7e746\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E07\",\n+            \"path\": \"src/db/sqlengine/planner/fts_recall_node.cc\",\n+            \"start_line\": 110,\n+            \"end_line\": 140,\n+            \"span_sha256\": \"7b04fd94ff4269e863ccac8cb7e1e01f606209cb93840bd3a7f7b41e02e4b97d\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E08\",\n+            \"path\": \"src/db/index/column/fts_column/fts_types.h\",\n+            \"start_line\": 24,\n+            \"end_line\": 35,\n+            \"span_sha256\": \"eefed39202d25efab045e23db2abaed0bf43598da06b54015fbf9576998131fe\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E09\",\n+            \"path\": \"src/db/index/column/fts_column/fts_column_indexer.cc\",\n+            \"start_line\": 194,\n+            \"end_line\": 259,\n+            \"span_sha256\": \"ca0359539b52293f5b9cb0858a5f37718871b5fa0dfc612d37c600c4216c0f62\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E10\",\n+            \"path\": \"src/db/sqlengine/planner/invert_recall_node.cc\",\n+            \"start_line\": 30,\n+            \"end_line\": 85,\n+            \"span_sha256\": \"2b564ff18ebdf0f36fe4b0c071aa62b109a49166bc4e500afa329030ea20756f\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E11\",\n+            \"path\": \"src/db/index/column/inverted_column/inverted_search_result.h\",\n+            \"start_line\": 48,\n+            \"end_line\": 155,\n+            \"span_sha256\": \"297d13165937b31ee5861a311bb1c5967208c0ad43fceb9efadc92a6cc4c6cc7\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E12\",\n+            \"path\": \"src/db/index/column/inverted_column/inverted_search_result.h\",\n+            \"start_line\": 173,\n+            \"end_line\": 178,\n+            \"span_sha256\": \"8053387db21a4f9e464b57f8d8995cdb095ebc5633e4077b97be3aea7a7059ee\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E13\",\n+            \"path\": \"tests/db/index/column/fts_column/fts_column_indexer_test.cc\",\n+            \"start_line\": 1765,\n+            \"end_line\": 1805,\n+            \"span_sha256\": \"9074b48ec2b4c72f824291b995a5479f335c53f87e6faa8c01c540dc6ec26828\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E14\",\n+            \"path\": \"src/db/sqlengine/planner/vector_recall_node.cc\",\n+            \"start_line\": 158,\n+            \"end_line\": 169,\n+            \"span_sha256\": \"d6d1e3fdccbeeeb24c867d8a2119289cdc82643de374d80867d87fc69828e8fd\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E15\",\n+            \"path\": \"src/db/index/column/vector_column/combined_vector_column_indexer.cc\",\n+            \"start_line\": 299,\n+            \"end_line\": 325,\n+            \"span_sha256\": \"f14312c9f97c538864d2de971940c10d909e8b35df8ee78af85a9706e7caab6b\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E16\",\n+            \"path\": \"src/db/common/config.cc\",\n+            \"start_line\": 38,\n+            \"end_line\": 40,\n+            \"span_sha256\": \"2d7800a54a94f7fbb14b38ab775460bef1beae4d094b10e92f096bcc131bb987\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E17\",\n+            \"path\": \"src/db/sqlengine/planner/optimizer.cc\",\n+            \"start_line\": 31,\n+            \"end_line\": 45,\n+            \"span_sha256\": \"5fdd01938cad9c53e8b2cc436c1e6b0b352dcb72640b94e7d46b699220b609aa\",\n+            \"matches_rubric\": true\n+          }\n+        ]\n+      },\n+      \"coverage_summary\": \"Five 2-point criteria. This is an indexed scalar restriction → planner handoff → FTS consumer contract failure, with scalar-only/forward/nonempty controls and an end-to-end semantic repair; it is not a generic null-bitmap or vector-search question.\",\n+      \"cross_file_chain\": [\n+        {\n+          \"step\": \"Route scalar conditions and select query path\",\n+          \"criteria\": [\n+            \"C1\",\n+            \"C3\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E01\",\n+            \"E02\",\n+            \"E03\",\n+            \"E04\"\n+          ],\n+          \"required_causal_explanation\": \"Analyzer separates indexed and forward predicates; planner builds DocFilter and selects FTS versus scalar-only execution. Positive predicates need not use candidate extraction: a retained bitmap or forward path is valid.\"\n+        },\n+        {\n+          \"step\": \"Consume a computed zero-match indexed restriction\",\n+          \"criteria\": [\n+            \"C1\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E05\",\n+            \"E06\",\n+            \"E11\"\n+          ],\n+          \"required_causal_explanation\": \"The count-zero result qualifies for candidate extraction, produces an engaged empty optional, and resets invert_filter_/invert_result_. Zero matches is a restriction, not no condition; a non-null zero-cardinality bitmap has the same downstream problem.\"\n+        },\n+        {\n+          \"step\": \"Lose the absent-versus-empty distinction at the FTS boundary\",\n+          \"criteria\": [\n+            \"C2\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E07\",\n+            \"E08\",\n+            \"E09\"\n+          ],\n+          \"required_causal_explanation\": \"FtsRecallNode moves the optional value into an ordinary vector; its empty default also means unrestricted. FTS intersects only nonempty candidates. The indexed predicate was consumed, so remaining filtering cannot recreate it and matching text hits escape.\"\n+        },\n+        {\n+          \"step\": \"Explain the separate controls\",\n+          \"criteria\": [\n+            \"C3\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E01\",\n+            \"E02\",\n+            \"E05\",\n+            \"E09\",\n+            \"E10\",\n+            \"E11\",\n+            \"E16\",\n+            \"E17\"\n+          ],\n+          \"required_causal_explanation\": \"Scalar-only has no rows from the empty iterator; unindexed forward predicates remain evaluated; positive and disjoint nonempty restrictions remain meaningful. Exact threshold arithmetic/optimizer details corroborate the allowed paths and are not extra point-bearing requirements.\"\n+        },\n+        {\n+          \"step\": \"Repair all three candidate states and preserve other filtering\",\n+          \"criteria\": [\n+            \"C4\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E05\",\n+            \"E06\",\n+            \"E07\",\n+            \"E08\",\n+            \"E09\"\n+          ],\n+          \"required_causal_explanation\": \"Preserve absent/unrestricted, present-empty/reject-all and nonempty/restricted semantics across producer and consumer, or safely stop a computed zero result before constraint loss. Retain ordinary unfiltered results and remaining delete/forward filtering.\"\n+        },\n+        {\n+          \"step\": \"State concrete ID-set regression and boundary expectations\",\n+          \"criteria\": [\n+            \"C5\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E09\",\n+            \"E10\",\n+            \"E13\"\n+          ],\n+          \"required_causal_explanation\": \"Cover indexed zero-match plus matching text with empty expected IDs and scalar-only/unindexed control; separately cover no restriction, nonempty overlap and nonempty disjoint behavior without changing valid topk/filter semantics. No executable test or post-fix test name is required.\"\n+        }\n+      ],\n+      \"grading_clarity\": \"Success and critical/citation gates are explicit. The remaining practical ambiguity is how compound 2-point control/test groups and preservation clauses are applied; use one prospective host-only interpretation for both conditions.\",\n+      \"prospective_host_only_clarifications\": [\n+        {\n+          \"id\": \"q002-control-units\",\n+          \"location\": \"criteria.C3.full_credit/partial_credit\",\n+          \"risk\": \"The second point combines unindexed-forward behavior with positive/disjoint controls; the phrase positive or disjoint can be read as allowing one listed control to substitute for explaining the others.\",\n+          \"recommended_contract\": \"Keep the two original groups: first point requires scalar-only empty-iterator explanation. The second requires unindexed forward-predicate preservation plus a correct causal account of the reported positive and disjoint outcomes; one shared restriction/intersection explanation may cover both. Do not require every control to use candidate-ID extraction or demand literal threshold constants. No half-points and no reward for just repeating the prompt ID sets.\",\n+          \"threshold_change\": false\n+        },\n+        {\n+          \"id\": \"q002-repair-preservation\",\n+          \"location\": \"criteria.C4.full_credit/partial_credit\",\n+          \"risk\": \"A repair that names optional candidates can sound complete while omitting consumed-filter timing or preservation of unrestricted and remaining-filter behavior, analogous to an overlooked compound clause.\",\n+          \"recommended_contract\": \"Full C4 requires a source-grounded end-to-end distinction between absent, explicit empty and nonempty restrictions, including ordinary unfiltered behavior and remaining delete/forward semantics. Equivalent safe zero-result short-circuit is accepted. The answer may establish preservation by an explicit unchanged-filter path or causal explanation; exact delete/forward keywords or patch spelling are not required. Do not infer omitted semantics from an auditor’s implementation sketch. Apply the existing 1-point partial anchor otherwise; pointer-only make_filter changes do not earn full credit.\",\n+          \"threshold_change\": false\n+        },\n+        {\n+          \"id\": \"q002-regression-units\",\n+          \"location\": \"criteria.C5.full_credit/partial_credit\",\n+          \"risk\": \"Two explicitly defined test groups may otherwise be blended into a vague test-many-cases point, or topk wording may be turned into an unannounced large test matrix.\",\n+          \"recommended_contract\": \"Score the original groups independently: 1 for explicit zero-match indexed+FTS empty-ID expectation with a scalar-only or unindexed control; 1 for explicit unrestricted, overlap and disjoint expectations that preserve topk/remaining-filter behavior. Preserve the stated two zero-match predicate families in the explanation; do not add a requirement to execute tests, reproduce every upstream test or enumerate unrequested topk sizes.\",\n+          \"threshold_change\": false\n+        }\n+      ],\n+      \"scope_guards\": [\n+        \"The FTS consumer, not vector-only recall, is the proven failing path. E14/E15 constrain overclaims and are not extra mandatory answer coverage.\",\n+        \"The absence of deletes in the concrete fixture does not erase the original repair requirement to preserve remaining filters.\",\n+        \"No new error-propagation point is imported from q001 C6: q002 must be scored against its own unchanged criteria.\"\n+      ]\n+    },\n+    \"q003\": {\n+      \"source_commit\": \"68078e55e7ae9d705b8829b5d416e022060bebf7\",\n+      \"source_root_checked\": \"/tmp/zg-qa-candidate-724-20261020/source-pre-fix\",\n+      \"instruction_and_rubric_match_dataset\": true,\n+      \"prior_final_review_verdict\": \"passed_independent_static_package_review\",\n+      \"prior_final_review_unresolved_items\": [],\n+      \"maximum_score\": 10,\n+      \"success_rule_unchanged\": {\n+        \"minimum_points\": 8,\n+        \"required_full_credit\": [\n+          \"C2\",\n+          \"C3\"\n+        ],\n+        \"critical_contradictions_allowed\": 0,\n+        \"supporting_citations_required_for_core_claims\": true,\n+        \"final_answer_required\": true,\n+        \"required_full_credit_points\": {\n+          \"C2\": 2,\n+          \"C3\": 2\n+        },\n+        \"core_citation_gate\": {\n+          \"criteria\": [\n+            \"C2\",\n+            \"C3\"\n+          ],\n+          \"rule\": \"For each core criterion, the answer must give existing pre-fix file paths and line numbers whose cited content jointly supports both awarded point units. Judge the actual frozen source, not literal equality with curated ranges. A post-fix-only, fabricated, wrong-revision, or materially unrelated citation cannot satisfy this gate. Missing core citations fail the answer even if its prose is correct.\",\n+          \"required_record\": \"For each core unit record the answer citation, verified pre-fix location, and a short explanation of how it supports the unit.\"\n+        },\n+        \"rule\": \"source_grounded_success = nonempty final answer AND total_points >= 8 AND C2 == 2 AND C3 == 2 AND all core citation gates pass AND no substantiated disqualifying overclaim or critical contradiction. Any such disqualification forces failure independently of points.\"\n+      },\n+      \"critical_contradictions_unchanged\": [\n+        \"C1: The single-segment vector-only path compacts forward rows in coordination with the filtered vectors, while identifying that same path as the cause.\",\n+        \"C2: There is no vector/forward association error; the scenario is solely ordinary approximate-search recall loss.\",\n+        \"C3: Read-only reopening repairs the persisted vector-key mapping.\",\n+        \"C4: Disabling tombstone filtering during queries is the repair.\",\n+        \"C5: No vector storage or vector indexer exists before the first optimize, or an existing default FLAT indexer means the requested HNSW index is already marked built.\",\n+        \"D1: Treat the original tail-only description as complete and explicitly deny wrong-vector associations.\",\n+        \"D2: Every overwrite/delete followed by optimize is affected regardless of the maintenance path.\",\n+        \"D3: Repairing only absent tail rows with vectors fetched from the affected index fully repairs all wrong associations.\",\n+        \"D4: Assert a local runtime reproduction or passing upstream test execution without supporting execution evidence.\"\n+      ],\n+      \"evidence_validation\": {\n+        \"unique_source_files\": 14,\n+        \"pre_fix_spans\": 29,\n+        \"errors\": [],\n+        \"file_hashes\": {\n+          \"src/db/index/segment/segment.cc\": {\n+            \"sha256\": \"d7ad713381ade9b0d7eda4738d68818d32e428e11aec0c475421b20a644e87dd\",\n+            \"bytes\": 169756\n+          },\n+          \"src/db/collection.cc\": {\n+            \"sha256\": \"5ef463e80b8e45bc8423621f47df60c140316a78faf7d557c48a8a2be8f0f3b8\",\n+            \"bytes\": 84950\n+          },\n+          \"src/db/common/constants.h\": {\n+            \"sha256\": \"bf3fc2f3614c88e3241b887314011d3370fc0b0dd5df13b8c27e6317a8df0972\",\n+            \"bytes\": 2585\n+          },\n+          \"src/db/index/column/vector_column/vector_column_indexer.cc\": {\n+            \"sha256\": \"4ac1bc0ff808647562e06b5252296b4b3e3be602b6debee8b26a296368003d48\",\n+            \"bytes\": 7189\n+          },\n+          \"src/core/interface/index.cc\": {\n+            \"sha256\": \"5d850cfddbbbeeed943925349bb9073a3a9caf27c04b0ee5c40fc013bed3687b\",\n+            \"bytes\": 38951\n+          },\n+          \"src/core/mixed_reducer/mixed_streamer_reducer.cc\": {\n+            \"sha256\": \"cd95c46f5bffd64d2de508f787e7185509c565e7ac0522ba9b499c48c1ccce49\",\n+            \"bytes\": 20926\n+          },\n+          \"src/db/index/column/vector_column/combined_vector_column_indexer.cc\": {\n+            \"sha256\": \"d5a5b9e32530945d7cc37bdcc1916ec49d8cb54cd4dbf04aecaf0f5455c0a267\",\n+            \"bytes\": 16823\n+          },\n+          \"src/db/sqlengine/planner/vector_recall_node.cc\": {\n+            \"sha256\": \"ac32505fd2c3918cef8e98003420f002605ce3cecfc8203d72ef7530b9aee5d3\",\n+            \"bytes\": 11612\n+          },\n+          \"src/db/sqlengine/planner/doc_filter.cc\": {\n+            \"sha256\": \"4e7697d5f338d162155d1bb57f72d4c8f984bafdf558a1668360d8983e4f1346\",\n+            \"bytes\": 5705\n+          },\n+          \"src/db/index/segment/segment_helper.cc\": {\n+            \"sha256\": \"5c98a0933175e31bc79e4ff5e9f53218ebfb3697b49de4584ecf41bdfcc9c522\",\n+            \"bytes\": 43912\n+          },\n+          \"src/db/index/common/meta.h\": {\n+            \"sha256\": \"95b922926cba785f864caa2f9ff772a57ac230e15519ed23bac1b5b31fbee2a9\",\n+            \"bytes\": 11956\n+          },\n+          \"src/include/zvec/db/index_params.h\": {\n+            \"sha256\": \"78db0e38fcfe1c209f4cb825dbfbac5dd8004c3027280ea43d04ad81baf5d9fd\",\n+            \"bytes\": 33262\n+          },\n+          \"src/db/sqlengine/planner/query_planner.cc\": {\n+            \"sha256\": \"a70a648be39e042f3159f54014d1d4e2e1ec0c6a009e8b6753ef808aeecc2708\",\n+            \"bytes\": 26476\n+          },\n+          \"src/db/sqlengine/planner/ops/check_not_filtered_op.cc\": {\n+            \"sha256\": \"c3f007817c4ca97fe4d28e90829a43c901a81824e8b1ea7183d4cd54051088a7\",\n+            \"bytes\": 2792\n+          }\n+        },\n+        \"span_checks\": [\n+          {\n+            \"id\": \"E01\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 868,\n+            \"end_line\": 935,\n+            \"span_sha256\": \"02a3046daba8476092063043d1bcee33e9ad8cb7a081ab11efcca5cc11a207a5\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E02\",\n+            \"path\": \"src/db/collection.cc\",\n+            \"start_line\": 529,\n+            \"end_line\": 544,\n+            \"span_sha256\": \"2d5b938ca12a37a9919d8f6c25d39583b8a385937a1bd5009120d8dc56281966\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E03\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 616,\n+            \"end_line\": 626,\n+            \"span_sha256\": \"1bb16bb8275b06eb963f477d970c65458ee9c0409556eef19f0388474f76f26e\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E04\",\n+            \"path\": \"src/db/collection.cc\",\n+            \"start_line\": 910,\n+            \"end_line\": 952,\n+            \"span_sha256\": \"b9bb920fd2055fbc96404180c683ca92b6f7b842e4ffe84205ce39977309ae33\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E05\",\n+            \"path\": \"src/db/collection.cc\",\n+            \"start_line\": 1086,\n+            \"end_line\": 1173,\n+            \"span_sha256\": \"f3165071a4addf46c9dee759ec4120e50a682fe84df2beb04ec3fb2ba6c2e1b0\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E06\",\n+            \"path\": \"src/db/common/constants.h\",\n+            \"start_line\": 35,\n+            \"end_line\": 45,\n+            \"span_sha256\": \"c765593242ebdce79a06f0ebd78d5407d3365bc3fa24db9ecbd50d8be92c6c02\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E07\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 464,\n+            \"end_line\": 475,\n+            \"span_sha256\": \"2b5f976f9ac7e64f63617ed650fbe4396864f9c49acb411f46871f74228c59b5\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E08\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 1466,\n+            \"end_line\": 1578,\n+            \"span_sha256\": \"3d7116702f5528d0951ce88fff42e7328cc80d1e26c0dc5bf6ea6cbb9ee2cb7b\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E09\",\n+            \"path\": \"src/db/index/column/vector_column/vector_column_indexer.cc\",\n+            \"start_line\": 103,\n+            \"end_line\": 132,\n+            \"span_sha256\": \"405d8a73a889cbc45feaed5e8902f9b229ecb43ab22df08ac9530347b4e0e631\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E10\",\n+            \"path\": \"src/core/interface/index.cc\",\n+            \"start_line\": 1016,\n+            \"end_line\": 1076,\n+            \"span_sha256\": \"153f2f3c776921205fa65c060ef50d9f9a67d8e05de4a2984a466e072cc1ba2a\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E11\",\n+            \"path\": \"src/core/mixed_reducer/mixed_streamer_reducer.cc\",\n+            \"start_line\": 255,\n+            \"end_line\": 325,\n+            \"span_sha256\": \"91e0749ccc20a2a57645191065584c733177f7f903730472bccfc912ad00c1ac\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E12\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 1028,\n+            \"end_line\": 1127,\n+            \"span_sha256\": \"6797769c3a4c4e2ba4f58149e2983cfb641da1a46c5f6d0bee8056fc022d5c9b\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E13\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 1268,\n+            \"end_line\": 1308,\n+            \"span_sha256\": \"382f536061eeb2a11a88040784d9701d4acd02367d4ac03c0c6a8cec51e1738f\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E14\",\n+            \"path\": \"src/db/index/column/vector_column/combined_vector_column_indexer.cc\",\n+            \"start_line\": 54,\n+            \"end_line\": 75,\n+            \"span_sha256\": \"d9a972edf32804b2921821a36922522882a81b252f4c92dc601e909cbb8c9754\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E15\",\n+            \"path\": \"src/db/sqlengine/planner/vector_recall_node.cc\",\n+            \"start_line\": 216,\n+            \"end_line\": 237,\n+            \"span_sha256\": \"417f85420d495d7ab2f792603f75f3d531d499fbec1708f2a84ec0749c1d98c1\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E16\",\n+            \"path\": \"src/db/sqlengine/planner/doc_filter.cc\",\n+            \"start_line\": 68,\n+            \"end_line\": 85,\n+            \"span_sha256\": \"798960ee6e5ec418f9e1e0a712442682980967424babe63d533b763370b011be\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E17\",\n+            \"path\": \"src/db/index/segment/segment_helper.cc\",\n+            \"start_line\": 100,\n+            \"end_line\": 171,\n+            \"span_sha256\": \"3d655de412e9bbf40faf5cdc2b6dd3a93f0b4d2722b0d455bab453d0676afe22\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E18\",\n+            \"path\": \"src/db/index/segment/segment_helper.cc\",\n+            \"start_line\": 232,\n+            \"end_line\": 280,\n+            \"span_sha256\": \"93862ae6c3cfaeba33b0ae6117bbddeb8835b976bc1e920f1ea9bb0642ecfd20\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E19\",\n+            \"path\": \"src/db/index/segment/segment_helper.cc\",\n+            \"start_line\": 934,\n+            \"end_line\": 995,\n+            \"span_sha256\": \"fdccde00925901b952966a88fdb963117fa34f6f6e83831c8ccb2640c6c95c8e\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E20\",\n+            \"path\": \"src/db/collection.cc\",\n+            \"start_line\": 1009,\n+            \"end_line\": 1070,\n+            \"span_sha256\": \"ad5ed749b1b72e98be39e01a0ba9788f5a8fbe4e61b20abe0f4b9006ffdd552f\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E21\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 536,\n+            \"end_line\": 556,\n+            \"span_sha256\": \"21cfaecde1e3c8f9cc032cf39c1865cde5ce5ebc9b171c3bd62f0e2e84c7f7c2\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E22\",\n+            \"path\": \"src/db/index/common/meta.h\",\n+            \"start_line\": 341,\n+            \"end_line\": 355,\n+            \"span_sha256\": \"7639c73b13a90cb46e1da9424270f35d710db85b14882dc6ea34b9c0144a00e1\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E23\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 4117,\n+            \"end_line\": 4138,\n+            \"span_sha256\": \"37faf3600f1059178b8dcb9403916126a26c086a4d3124063fd86117417c6477\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E24\",\n+            \"path\": \"src/include/zvec/db/index_params.h\",\n+            \"start_line\": 570,\n+            \"end_line\": 578,\n+            \"span_sha256\": \"ba0419f68b07195d193bade95728f4310ef369bee87453dd759ecad0bdc3dadd\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E25\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 4382,\n+            \"end_line\": 4396,\n+            \"span_sha256\": \"5d0990a7e309c912ea8c9249f52bfd7cb84670f6399a1ee02637cebc221c6954\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E26\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 1470,\n+            \"end_line\": 1486,\n+            \"span_sha256\": \"7736c96c037024fbbb0071fba6686bfabeb92718ffe83572548036b573ed7e1b\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E27\",\n+            \"path\": \"src/db/index/segment/segment.cc\",\n+            \"start_line\": 1525,\n+            \"end_line\": 1540,\n+            \"span_sha256\": \"8e58980d421b4d91b221074c8c5c2a5ccd9f5f425dea48bd1ea319c417c95e14\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E28\",\n+            \"path\": \"src/db/sqlengine/planner/query_planner.cc\",\n+            \"start_line\": 467,\n+            \"end_line\": 493,\n+            \"span_sha256\": \"9c3f72c004e87b875feda7e917d65a2635e420adb71934c0e795808c35d0acee\",\n+            \"matches_rubric\": true\n+          },\n+          {\n+            \"id\": \"E29\",\n+            \"path\": \"src/db/sqlengine/planner/ops/check_not_filtered_op.cc\",\n+            \"start_line\": 21,\n+            \"end_line\": 41,\n+            \"span_sha256\": \"d8ac2e2f044665796cd384002fd17357ab0bee85027849065cbcb4bbfb8793f6\",\n+            \"matches_rubric\": true\n+          }\n+        ]\n+      },\n+      \"coverage_summary\": \"Eight criteria with ten explicit integer point units; C2 and C3 are mandatory 2/2 core criteria. It spans deletion/state, maintenance choice, existing vector-storage lifecycle, dense vector-key rewriting, read joins, persistence, bounded controls, coordinated compaction and an independent regression oracle.\",\n+      \"cross_file_chain\": [\n+        {\n+          \"step\": \"Distinguish logical deletion from physical storage\",\n+          \"criteria\": [\n+            \"C1\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E01\",\n+            \"E02\",\n+            \"E03\"\n+          ],\n+          \"required_causal_explanation\": \"Delete tombstones the global ID/removes external-ID mapping while retaining physical rows/doc_ids; physical=28 and live=25 because statistics filter deletion.\"\n+        },\n+        {\n+          \"step\": \"Select the vector-only maintenance path and identify existing storage\",\n+          \"criteria\": [\n+            \"C2\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E04\",\n+            \"E05\",\n+            \"E06\",\n+            \"E08\",\n+            \"E21\",\n+            \"E22\",\n+            \"E23\",\n+            \"E24\",\n+            \"E25\"\n+          ],\n+          \"required_causal_explanation\": \"Apply the strict physical/live threshold, then trace single-segment CreateVectorIndexTask without coordinated forward purge. Non-quantized inserts already created default FLAT memory vector storage and flush persisted it; the requested HNSW built flag is initially unset. Both C2 units and their actual citations are required.\"\n+        },\n+        {\n+          \"step\": \"Connect filtered vector merge to dense survivor keys\",\n+          \"criteria\": [\n+            \"C3\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E07\",\n+            \"E08\",\n+            \"E09\",\n+            \"E10\",\n+            \"E11\"\n+          ],\n+          \"required_causal_explanation\": \"The deletion filter maps original rows to deleted global IDs; Merge enables PK rewrite; the reducer skips deleted vectors and assigns consecutive survivor keys while forward/doc_ids and block metadata retain physical coordinates. Both C3 units and their actual citations are required.\"\n+        },\n+        {\n+          \"step\": \"Explain inconsistent reads and persistence\",\n+          \"criteria\": [\n+            \"C4\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E12\",\n+            \"E13\",\n+            \"E14\",\n+            \"E15\",\n+            \"E02\",\n+            \"E20\",\n+            \"E28\",\n+            \"E29\"\n+          ],\n+          \"required_causal_explanation\": \"Search keys join to forward IDs/fields and vector fetch uses original physical offsets, causing wrong associations or tail failures. Counts/scalar scans can agree because they use retained rows with deletion filtering. Committed rebuilt index/metadata persists across read-only reopen.\"\n+        },\n+        {\n+          \"step\": \"Explain the exact empty and clean-first controls\",\n+          \"criteria\": [\n+            \"C5\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E04\",\n+            \"E21\",\n+            \"E23\",\n+            \"E24\",\n+            \"E26\",\n+            \"E27\",\n+            \"E01\"\n+          ],\n+          \"required_causal_explanation\": \"Empty optimize builds nothing; clean first requested-index materialization retains alignment and records indexed state. The later same-parameter delete-only rebuild skips on the flag; this does not establish directory-wide immunity.\"\n+        },\n+        {\n+          \"step\": \"Contrast coordinated high-delete compaction\",\n+          \"criteria\": [\n+            \"C6\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E05\",\n+            \"E17\",\n+            \"E18\",\n+            \"E19\"\n+          ],\n+          \"required_causal_explanation\": \"Scalar reduction filters forward rows and records omitted original positions in a bitmap also used by vector reduction, keeping both spaces aligned. CompactTask alone is not proof of purging because it can receive no purge filter.\"\n+        },\n+        {\n+          \"step\": \"State the mapping repair invariant\",\n+          \"criteria\": [\n+            \"C7\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E08\",\n+            \"E16\",\n+            \"E17\"\n+          ],\n+          \"required_causal_explanation\": \"Retain tombstoned vector slots if forward coordinates remain unchanged, or remap both sides consistently; preserve logical deletion filtering during reads. Exact nullptr spelling is not required.\"\n+        },\n+        {\n+          \"step\": \"Specify an independent association oracle\",\n+          \"criteria\": [\n+            \"C8\"\n+          ],\n+          \"evidence_ids\": [\n+            \"E13\",\n+            \"E15\"\n+          ],\n+          \"required_causal_explanation\": \"Use externally retained normalized reference directions and check the expected live ID plus vector payload after triggering delete/optimize. Counts or vectors fetched from the potentially corrupt same index are not independent oracles.\"\n+        }\n+      ],\n+      \"grading_clarity\": \"No unresolved q001-C6-style conflict between claim and full-credit wording was found. Prior independent R1/R2/R3/O3 fixes are already incorporated: explicit mandatory core gates, integer point units, bounded optional extensions, FLAT-versus-requested-HNSW lifecycle, and scalar enumeration support. Keep these definitions authoritative.\",\n+      \"prospective_host_only_clarifications\": [\n+        {\n+          \"id\": \"q003-point-unit-precedence\",\n+          \"location\": \"criteria[*].point_units/anchors; success_rule.core_citation_gate\",\n+          \"risk\": \"Summarizing C2 as only the 3/28 threshold or C3 as only dense renumbering would omit already explicit compound requirements.\",\n+          \"recommended_contract\": \"Apply the existing point_units and anchors verbatim; every conjunct in a unit must be causally supported. In C2, the second unit includes FLAT memory→persisted transfer, initially unset HNSW built flag and vector-only path. In C3, the second unit includes retained forward/doc_ids positions and physical block metadata. For each core unit record an actual answer citation and verified pre-fix support; auditor-added helper spans cannot supply an omitted answer citation.\",\n+          \"threshold_change\": false\n+        },\n+        {\n+          \"id\": \"q003-bounded-noncore-units\",\n+          \"location\": \"criteria.C4-C8.point_units/optional_extensions\",\n+          \"risk\": \"Noncore one-point compounds could be silently split or broadened beyond the predeclared bounds.\",\n+          \"recommended_contract\": \"No half-points. C4 includes scalar/count agreement and persisted/reopen consequence, while its wrong-association-or-tail wording does not demand every possible symptom. C5 requires both exact controls and indexed-flag skip. C6 requires coordinated scalar/vector filtering with the original-position bitmap. C7 retains logical read filtering. C8 requires external known directions plus ID and vector-payload correspondence; upsert, quantization, a broad matrix, reopen test, or literal patch syntax remain optional as already declared.\",\n+          \"threshold_change\": false\n+        },\n+        {\n+          \"id\": \"q003-disqualification-evidence\",\n+          \"location\": \"disqualification_policy and critical_contradictions\",\n+          \"risk\": \"Criterion IDs C1-C5 and contradiction IDs C1-C5 overlap, and an omitted claim can be mistaken for an affirmative contradiction.\",\n+          \"recommended_contract\": \"Namespace criterion and contradiction identifiers in review output. Apply a disqualifier only to a quoted explicit material assertion with frozen-source evidence; omission follows ordinary point and citation gates. Preserve the declared uncertainty/adjudication rule, rather than silently inferring or waiving a contradiction.\",\n+          \"threshold_change\": false\n+        }\n+      ],\n+      \"scope_guards\": [\n+        \"Do not add an ideal-decimal exactly-30-percent boundary rule; the rubric explicitly excludes it.\",\n+        \"Do not require literal curated source ranges, but actual cited content must jointly support both units of each core criterion.\",\n+        \"No absence-of-vector-storage explanation can be accepted merely because first requested HNSW materialization has not yet occurred.\",\n+        \"Read-only reopen, upsert and wider regression variants cannot become extra C8 requirements after seeing new answers.\"\n+      ]\n+    }\n+  },\n+  \"common_contract_before_new_answers\": [\n+    \"Keep both preselected tasks and every historical/new outcome; no favorable-subset selection, no historical regrading.\",\n+    \"Keep question/rubric/source bytes and maximum10/minimum8/core gates unchanged. Host-only notes clarify application, never enter solver prompts, source, MCP index or agent guidance.\",\n+    \"Evaluate only exact final-answer bytes using original question/rubric and task-specific pre-fix source. Preserve factual points separately from citation gates and material contradictions.\",\n+    \"Require actual path/line citations that support the causal unit; equivalent sufficient spans are allowed. Whole-file references and post-fix-only evidence do not satisfy core citation gates. Mark supplementary reviewer source as reviewer-added, never answer-cited.\",\n+    \"Use integer points and the original partial anchors. A cited range that contains an omitted causal explanation does not fill that omission; trajectories are not answer coverage.\",\n+    \"Do not add q001 error-handling, rubric headings, exact patch syntax or optional tests as new requirements. State all compound-clause interpretations prospectively and apply identically to both arms.\",\n+    \"Label the reviewer truthfully as model or human; the source-review package does not make a future model grade official or human.\",\n+    \"Report source-based inference separately from executed validation. Neither static review nor repository recency proves an exact native reproduction or training-data exclusion.\"\n+  ],\n+  \"existing_35_test_scope\": {\n+    \"method\": \"Static AST/source inspection only; no tests run in this review.\",\n+    \"files\": [\n+      {\n+        \"file\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_live.py\",\n+        \"sha256\": \"4acd8a867cc3f56470dfdc26ba1ae53f494cf002cd497b0df8dbe11761bd2cf9\",\n+        \"test_methods\": 15,\n+        \"mentions_q002_or_q003\": false\n+      },\n+      {\n+        \"file\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_accounting_v2.py\",\n+        \"sha256\": \"5436cd556eb33571205501b9f7f91fd9b8331ba98dfcc4a3cac1fa776620e05e\",\n+        \"test_methods\": 12,\n+        \"mentions_q002_or_q003\": false\n+      },\n+      {\n+        \"file\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/native-claude-qa-pilot/test_confirmation_v1.py\",\n+        \"sha256\": \"4c1c1e6a1df40633874bf3a4f89615e47d52a4e9cbf006bb00d5e7d3919c3259\",\n+        \"test_methods\": 8,\n+        \"mentions_q002_or_q003\": false\n+      }\n+    ],\n+    \"total_test_methods\": 35,\n+    \"finding\": \"15 live +12 accounting_v2 +8 confirmation tests cover generic boundaries and q001 fixtures, not q002/q003 task-specific question/source/rubric identity or execution. test_live.py:181 fixes runs/q001-{profile}; test_accounting_v2.py:94 replays q001 R3; test_confirmation_v1.py:175-195 reuses the fixed live fixture.\",\n+    \"execution_readiness_owned_separately\": true\n+  },\n+  \"limits\": {\n+    \"current_confirmation_raw_or_answers_read\": false,\n+    \"historical_answers_or_scores_read_this_review\": false,\n+    \"historical_results_modified_or_regraded\": false,\n+    \"solver_provider_or_CI_calls\": false,\n+    \"repository_code_executed\": false,\n+    \"prompt_rubric_or_runtime_modified\": false,\n+    \"new_candidates_searched\": false,\n+    \"scope_exactly\": [\n+      \"q002\",\n+      \"q003\"\n+    ],\n+    \"independent_static_reviews_retained\": true\n+  },\n+  \"recommendation\": \"No prompt/rubric repair or easier gate is warranted. q002 benefits from an explicit host-only application note for C3/C4/C5 compounds; q003 needs faithful prospective restatement of existing units rather than another rubric revision. Execution adaptation and task identity validation remain separate prerequisites.\"\n+}"},{"sha":"3b2e618f012ed12375a9fae636e0b5296a7b46c2","filename":"benchmarks/native-claude-qa-pilot/provenance/native-expansion-v1/native-expansion-readiness-v1.json","status":"added","additions":444,"deletions":0,"changes":444,"blob_url":"https://github.com/Cuiyus/zvec-grep/blob/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-readiness-v1.json","raw_url":"https://github.com/Cuiyus/zvec-grep/raw/bbc15485ca317427f6b19cab4dc449c50d3ef731/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-readiness-v1.json","contents_url":"https://api.github.com/repos/Cuiyus/zvec-grep/contents/benchmarks%2Fnative-claude-qa-pilot%2Fprovenance%2Fnative-expansion-v1%2Fnative-expansion-readiness-v1.json?ref=bbc15485ca317427f6b19cab4dc449c50d3ef731","patch":"@@ -0,0 +1,444 @@\n+{\n+  \"schema_version\": 1,\n+  \"created_at_utc\": \"2026-10-19T23:52:20.259545+00:00\",\n+  \"reviewed_worktree_head\": \"fd0c94c37c95e2afb4b5482530904574f5719c5f\",\n+  \"purpose\": \"Read-only readiness facts for a possible separately authorized native-Claude phase on both existing reserves; no expansion execution is authorized.\",\n+  \"current_confirmation_run_untouched\": 39343873279,\n+  \"selection\": [\n+    \"q002\",\n+    \"q003\"\n+  ],\n+  \"dataset\": {\n+    \"path\": \"/Users/cc/.codex/worktrees/claude-zvec-qa-pilot/zvec-grep/benchmarks/zvec-issue-qa/dataset-expansion-v1.json\",\n+    \"sha256\": \"e874a1d6509