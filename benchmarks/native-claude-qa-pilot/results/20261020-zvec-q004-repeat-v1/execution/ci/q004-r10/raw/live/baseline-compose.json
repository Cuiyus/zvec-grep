{
  "services": {
    "main": {
      "platform": "linux/amd64",
      "volumes": [
        {
          "source": "agent-setup-cache",
          "target": "/root/.nvm",
          "type": "volume"
        },
        {
          "source": "claude-code-install-cache",
          "target": "/root/.local",
          "type": "volume"
        }
      ]
    }
  },
  "volumes": {
    "agent-setup-cache": {
      "external": true,
      "name": "zg-bench-claude-code-2.1.212-baseline-linux-x64"
    },
    "claude-code-install-cache": {
      "external": true,
      "name": "zg-bench-claude-code-2.1.212-baseline-linux-x64-local"
    }
  }
}
