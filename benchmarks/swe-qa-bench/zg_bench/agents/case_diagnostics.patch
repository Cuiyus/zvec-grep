+++ b/rust/crates/zg-engine/src/pipelines/indexed_search/case_diagnostics.rs
@@ -0,0 +1,28 @@
+//! Separate pilot build only: append full internal candidates outside the corpus.
+use std::io::Write;
+use super::pipeline::SearchHit;
+
+pub(super) fn enabled() -> bool {
+    std::env::var_os("ZG_CASE_DIAGNOSTICS").is_some()
+}
+
+pub(super) fn emit(value: serde_json::Value) {
+    if let Some(path) = std::env::var_os("ZG_CASE_DIAGNOSTICS") {
+        let mut file = std::fs::OpenOptions::new().create(true).append(true).open(path)
+            .expect("open case diagnostics");
+        writeln!(file, "{}", value).expect("write case diagnostics");
+    }
+}
+
+pub(super) fn hit(hit: &SearchHit) -> serde_json::Value {
+    serde_json::json!({
+        "entity_id": hit.entity.id().as_str(),
+        "path": hit.file.relative_path().display().to_string(),
+        "range": hit.entity.source_range(),
+        "metadata": format!("{:?}", hit.entity.metadata()),
+        "content": format!("{:?}", hit.entity.content()),
+        "fragments": format!("{:?}", hit.entity.fragments()),
+        "evidence": format!("{:?}", hit.evidence),
+        "rank": hit.rank, "score": hit.score, "trace": hit.trace,
+    })
+}
